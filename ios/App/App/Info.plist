<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>WorkBench</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>WorkBench uses the camera so you can take photos of job sites and attach them to jobs.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>WorkBench accesses your photo library so you can attach existing photos to jobs.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>WorkBench can save job photos to your photo library.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>WorkBench uses Face ID to unlock the app when App Lock is turned on.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>WorkBench uses the microphone to take and place business-line calls inside the app.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>WorkBench records your location only when you clock in or out and while you're on the clock, so your team can see where work is happening, and Square requires it while you take a Tap to Pay payment. It is never tracked otherwise.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Square's payment SDK uses Bluetooth to find card readers. Tap to Pay on iPhone itself needs no reader.</string>
	<!-- Square Mobile Payments SDK application id, from the SQUARE_APPLICATION_ID build
	     setting (project.pbxproj): Release = the production id, Debug = the SANDBOX id
	     (sandbox test build with the mock reader). Empty = Tap to Pay stays off
	     (TapToPayPlugin reports configured: false). -->
	<key>SquareApplicationID</key>
	<string>$(SQUARE_APPLICATION_ID)</string>
	<!-- Non-empty = the shell loads this origin instead of workbenchfsm.com: the
	     WB_SHELL_ORIGIN build setting (Debug = staging for the Square sandbox test
	     build, Release = empty). Read by ShellViewController.instanceDescriptor. -->
	<key>WBShellOrigin</key>
	<string>$(WB_SHELL_ORIGIN)</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIBackgroundModes</key>
	<array>
		<!-- audio: a business-line call keeps talking when the app is backgrounded.
	     voip: PushKit wakes the closed app for an incoming call (VoipPlugin.swift). -->
		<string>audio</string>
		<string>remote-notification</string>
		<string>voip</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Google sign-in (the SDK returns to the app on this scheme): the iOS
	     OAuth client id REVERSED, e.g. com.googleusercontent.apps.1234-abcd.
	     Placeholder until GOOGLE_SIGNIN_IOS_CLIENT_ID exists — see
	     docs/plans/native-release-queue.md -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.550912391949-sk9e177coo9224u30jeeq1abvaoe22sr</string>
			</array>
		</dict>
	</array>
	<!-- HTTPS only; no proprietary crypto — skips the export-compliance
	     question on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>WKAppBoundDomains</key>
	<array>
		<string>workbenchfsm.com</string>
		<string>streamflaire-staging.up.railway.app</string>
	</array>
</dict>
</plist>
