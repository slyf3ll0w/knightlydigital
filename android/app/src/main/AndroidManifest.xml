<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:name=".HubApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Links: /app/* URLs open the shell instead of the browser.
                 Mirrors the AASA `applinks` scope — client-facing pages
                 (/hub /quote /pay ...) deliberately excluded. autoVerify
                 requires /.well-known/assetlinks.json to be live (middleware,
                 gated on ANDROID_CERT_SHA256) or Android silently ignores it. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="workbenchfsm.com" android:pathPrefix="/app" />
            </intent-filter>
        </activity>

        <!-- Business-line calls with the app closed (docs/plans/business-line-voice-2026-09-18.md
             § Tier 3, Android half). WbMessagingService takes over Firebase messaging
             from the Capacitor push plugin (it extends that service, so ordinary
             notifications are untouched) and hands a "call" data message to
             VoipEngine; CallService is the foreground service that rings
             (full-screen IncomingCallActivity over the lock screen, CallStyle
             notification, ringtone) and then keeps the call's process and
             microphone alive; IncomingCallActivity is the call screen. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".WbMessagingService"
            android:exported="false">
            <intent-filter android:priority="100">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name=".CallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone" />
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Talk to Atlas (SpeechPlugin.java): on Android 11+ an app only sees the
         phone's speech recognition service when it declares it here. Without
         this SpeechRecognizer.isRecognitionAvailable() is false and the page
         falls back to recording + server transcription. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Camera capture from web file inputs (profile pictures, job photos) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- App lock (components/AppLock.tsx): fingerprint/face unlock -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" android:maxSdkVersion="28" />
    <!-- Business-line calls in the webview (components/Softphone.tsx; native ringing is
         tier 3 of docs/plans/business-line-voice-2026-09-18.md): getUserMedia needs these -->
    <!-- Square Mobile Payments SDK (Tap to Pay): location is mandatory for every
         in-person payment (Square's fraud rules); Bluetooth + phone state are what
         the SDK declares for readers. NFC is the Tap to Pay radio; not required so
         phones without it still install (the button just never shows). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Calls with the app closed (CallService): a foreground service of type
         phoneCall (+ microphone once answered), the full-screen incoming-call
         screen over the lock screen, the ringtone's vibration, and the
         call-ownership declaration the phoneCall type expects. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- RECORD_AUDIO implies a required microphone, which drops mic-less tablets and
         TVs from Play (20 devices on the vc4 upload). The app runs without one. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
