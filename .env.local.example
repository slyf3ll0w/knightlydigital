# Copy this file to .env.local and fill in the values

# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# Railway PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Finix payment processing (optional locally) — see CLAUDE.md "Payment processor"
# PAYMENT_PROCESSOR=finix
# FINIX_ENVIRONMENT=sandbox
# FINIX_API_USERNAME=
# FINIX_API_PASSWORD=
# FINIX_APPLICATION_ID=
# Published processing rates (defaults: card 2.9% + 30¢, ACH 0.75%) — keep in
# sync with the fee profile configured in the Finix dashboard
# WORKBENCH_CARD_FEE_BPS=290
# WORKBENCH_CARD_FEE_FIXED_CENTS=30
# WORKBENCH_ACH_FEE_BPS=75
# WORKBENCH_ACH_FEE_FIXED_CENTS=0

# Google Calendar push (optional) — OAuth web client from console.cloud.google.com
# with redirect URI http://localhost:3000/api/app/integrations/google-calendar/callback
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=

# "Continue with Google" sign-in (optional; the buttons hide until both are
# set) — a SEPARATE OAuth web client in the same Google Cloud project, with
# redirect URI http://localhost:3000/api/auth/callback/google (prod:
# https://workbenchfsm.com/api/auth/callback/google). NEXTAUTH_URL must be the
# public origin in prod — NextAuth builds the redirect URI from it.
# GOOGLE_SIGNIN_CLIENT_ID=
# GOOGLE_SIGNIN_CLIENT_SECRET=

# Shared tester invite code (lib/invites.ts). Anyone entering it on the unlisted
# /invite page opens an account with review + underwriting skipped and online
# payments held back ("Coming soon"). Defaults to Workbench123 when unset;
# set a new value to rotate it, or "off" to disable the shared code.
# UNIVERSAL_INVITE_CODE=Workbench123

# Map tiles (lib/basemap.ts) — the Routes page, the team map and the estimate
# tools' satellite tracer. Optional: unset, every map falls back to
# OpenStreetMap streets + Esri imagery exactly as before. To turn it on, make a
# SEPARATE public token at account.mapbox.com/access-tokens (NOT the server
# MAPBOX_TOKEN): scopes styles:tiles + styles:read only, URL-restricted to
# https://workbenchfsm.com, https://streamflaire-staging.up.railway.app and
# http://localhost:3000. NEXT_PUBLIC_ vars are inlined at build time, so set it
# on BOTH Railway environments (staging + production) BEFORE the push that
# ships it, and add a Static Tiles usage alert at 80% of the free allowance
# in the Mapbox dashboard. The styles can be swapped for a Workbench style
# from Mapbox Studio ("username/style-id") without a code change.
# NEXT_PUBLIC_MAPBOX_TOKEN=pk....
# NEXT_PUBLIC_MAPBOX_STYLE=mapbox/light-v11
# NEXT_PUBLIC_MAPBOX_SATELLITE_STYLE=mapbox/satellite-streets-v12
