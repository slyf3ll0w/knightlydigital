generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenancy ─────────────────────────────────────────────────────────────────

model Company {
  id                        String      @id @default(cuid())
  name                      String
  slug                      String      @unique
  phone                     String?
  email                     String?
  address                   String?
  city                      String?
  state                     String?
  zip                       String?
  // Provider texts (Telnyx) go out for this company only after a manager has
  // turned text notifications on in Settings → Features — the one-time
  // acknowledgement that clients gave the business their numbers. Null = off;
  // lib/sms.ts sendSms refuses until it is set.
  smsAcknowledgedAt         DateTime?
  // Geocoded shop location (lib/geocoding.ts) — the Route Manager's default
  // start point for a tech's day. Refreshed when the address fields change;
  // null until geocoded (or when geocoding is disabled/failed).
  lat                       Float?
  lng                       Float?
  geocodedAt                DateTime?
  website                   String?
  // "About your business" (Settings → Business Info): what the business does,
  // in its own words. Shown on its public /book/<slug> page and used as the
  // opening of its texting campaign description — carriers want "a clear
  // description of its core business activities" (lib/business-profile.ts).
  about                     String?
  logoUrl                   String? // display URL; points at /api/logo/[id] for uploaded logos
  logoData                  Bytes? // uploaded logo bytes (small files only; move to R2 with job photos)
  logoMime                  String?
  brandColor                String? // primary brand hex: headers/surfaces on client-facing pages + app accent
  brandColorSecondary       String? // secondary brand hex: buttons/accents; falls back to brandColor
  // Client-document header hex (quotes, invoices, emails, hub, portal) —
  // decoupled from the in-app primary; falls back to brandColor when unset.
  documentColor             String?
  // App-wide Google Font override for the signed-in app (same free-text
  // Google Font convention as booking-form appearance.font). Body + display
  // text; ledger numerals/stamps stay Oxanium. Null = stock Inter/Oxanium.
  brandFont                 String?
  // Advanced customization: per-section hue overrides for the app's color
  // language ({ jobs: "#F97316", ... } — keys/validation in lib/section-colors.ts).
  // {} or null = the stock palette.
  sectionColors             Json?
  logoWallpaper             Boolean     @default(false) // legacy wallpaper toggle — superseded by `wallpaper`; null wallpaper + true here still means "logo"
  // App wallpaper behind every page: "none" | "logo" | "grid" | "dots" |
  // "blueprint" | "topo" | "pinstripe" (see WALLPAPERS in lib/wallpapers.ts).
  // Null = not chosen yet → falls back to logoWallpaper for pre-existing tenants.
  wallpaper                 String?
  sidebarTheme              String      @default("white") // desktop sidebar: "black" | "white" | "gray"
  sidebarLogoColor          String? // hex backdrop behind the sidebar logo panel; null = white
  sidebarLogoSize           Int? // desktop rail logo plate height in px (36–128); null = default 56
  timezone                  String      @default("America/Chicago")
  surchargeEnabled          Boolean     @default(false)
  surchargeRate             Decimal     @default(0.0300) @db.Decimal(5, 4)
  // Finix payment processing (Streamflaire Payments). The identity/merchant pair
  // comes from the hosted onboarding form; onboardingState mirrors Finix's
  // merchant onboarding_state (PROVISIONING | APPROVED | REJECTED |
  // UPDATE_REQUESTED). Online charges only run when APPROVED.
  finixOnboardingFormId     String?
  finixIdentityId           String?
  finixMerchantId           String?     @unique
  finixOnboardingState      String?
  // Payment verification is mandatory: new companies are held at /app/activate
  // until Finix underwriting approves them. This flag exempts a company from
  // that gate (test accounts, comped users) — flipped only from the superadmin
  // console.
  paymentsWaived            Boolean     @default(false)
  // Company-wide default deposit, applied to preset services with no deposit of
  // their own and used to prefill custom quotes. NONE = no default deposit.
  defaultDepositType        DepositType @default(NONE)
  defaultDepositValue       Decimal?    @db.Decimal(10, 2) // percent (0-100) or fixed dollars
  // Default sales-tax rate as a fraction (0.0825 = 8.25%). Prefills new quotes
  // and invoices and applies to engine-generated (recurring) invoices; each
  // document can still override or clear its own rate. null = no tax.
  defaultTaxRate            Decimal?    @db.Decimal(5, 4)
  reviewLink                String?
  // "On my way" text template ({{placeholder}} substitution per lib/messaging.ts);
  // null = the built-in default. Sent from the tech's own phone via an sms: link.
  onMyWayTemplate           String?
  bookingForm               Json? // LEGACY single-form config (pre multi-form) — superseded, kept for old rows
  bookingPage               Json? // the company's booking page look + words — see lib/booking-page.ts
  // The client hub's "Get work done" form: one BookingType id (any kind) that
  // existing clients see instead of the built-in title + details request form.
  // Null = the plain form. The item's DELETE route clears it. See lib/hub-form.ts.
  hubBookingTypeId          String?
  // Online booking (self-scheduling). businessHours: { mon: [{start:"08:00",end:"17:00"}], ... }
  // per lib/business-hours.ts; null = default weekday hours. serviceZips empty = no
  // service-area restriction. arrivalWindowMinutes = width of the promised window.
  businessHours             Json?
  serviceZips               String[]    @default([])
  arrivalWindowMinutes      Int         @default(120)
  // Drive-time limit for self-scheduling (minutes; null/0 = off). When on,
  // online booking only offers days where the visit clusters with the tech's
  // existing route — an anchor visit (or the shop) within this many estimated
  // drive minutes of the client's address. Requires the address before times
  // show. See bookingDriveFilter in lib/booking-availability.ts.
  bookingDriveLimitMinutes  Int?
  // Granularity of the even time-slot picker when staff schedule jobs/appointments
  // in-app (minutes). Resolved through lib/scheduling.ts, which is structured so a
  // future route-management system and per-service-type overrides can refine it.
  schedulingIntervalMinutes Int         @default(30)
  industry                  String? // onboarding answer; drives starter price book + future industry defaults
  // AI setup wizard: stamped when the owner applies OR dismisses it — hides
  // the dashboard card either way (the Settings entry stays available)
  setupWizardAt             DateTime?
  // Display name for the in-app AI assistant; null = the default ("Atlas")
  assistantName             String?
  // Atlas access (lib/assistant-access.ts). assistantEnabled is a superadmin
  // override: true = full Atlas regardless of plan (the whitelist — test
  // accounts, comped users), false = Atlas hidden entirely, null = the
  // default policy: a free monthly allowance of Atlas tokens
  // (ATLAS_FREE_TOKENS, refilled on the 1st), then the paid-plan upsell.
  // Every AI turn is real spend.
  assistantEnabled          Boolean?
  // Atlas free tier (lib/assistant-billing.ts): every company gets
  // ATLAS_FREE_TOKENS per calendar month, no sign-up step. Every turn's real
  // Gemini cost, priced as Atlas tokens, debits atlasFreeTokensUsed;
  // atlasFreePeriodStart names the month it belongs to and the assistant
  // route rolls it forward lazily (see debitAtlasTokens).
  atlasFreePeriodStart      DateTime?
  atlasFreeTokensUsed       Int         @default(0)
  // LEGACY (2026-09-04): the one-time free trial these two backed was
  // replaced by the monthly free tier above. Unread by code; drop them with
  // `node scripts/db-push-prod.mjs --accept-data-loss` then delete here.
  atlasTrialStartedAt       DateTime?
  atlasTrialTokensUsed      Int         @default(0)
  // Atlas paid plan (lib/assistant-billing.ts) — NOT LIVE yet: no checkout
  // is wired, the superadmin console grants/revokes it for testing. Same
  // meter as the free tier, bigger allowance: every turn's real Gemini cost
  // (usageMetadata × lib/platform-costs unit prices) converts to "Atlas
  // tokens" (ATLAS_TOKEN_CENTS each) and debits the period allowance
  // (ATLAS_PLAN_TOKENS per billing month, anchored on atlasPlanActiveAt —
  // the billing day). atlasPeriodStart names the period
  // atlasPeriodTokensUsed belongs to; the assistant route rolls it forward
  // lazily (see debitAtlasTokens).
  atlasPlanActiveAt         DateTime?
  atlasPlanLiverySubId      String? // future: the Livery Subscription id backing the plan
  atlasPeriodStart          DateTime?
  atlasPeriodTokensUsed     Int         @default(0)
  // Historical: stamped when a merchant came from the old sandbox
  // test-approve bypass (removed 2026-09-01 — everyone completes the hosted
  // underwriting form now; an invite code on /invite waives underwriting
  // instead). Kept for existing rows.
  finixSandboxApproved      Boolean     @default(false)
  // ── Premium add-on, sold through Livery (lib/addon.ts) ──
  // addonEnabled is the superadmin VISIBILITY switch: the upsell page and its
  // settings link only render while it's on (preview = on for Streamflaire
  // only). addonActiveAt is the ENTITLEMENT — stamped by the Livery webhook
  // when the subscription's first payment lands (or a superadmin override),
  // cleared on cancel / final payment failure. Gate features with
  // hasAddon(company), never on addonEnabled.
  addonEnabled              Boolean     @default(false)
  addonActiveAt             DateTime?
  addonLiverySubId          String? // Livery Subscription id backing the entitlement
  // ── Business line (lib/business-line.ts) — the tenant's own local number,
  // bought through Telnyx, carrying their automated texts AND a forwarded
  // business phone line. Texts send from it only once MessagingRegistration
  // is ACTIVE (10DLC); voice forwarding works from the minute it provisions.
  lineNumber                String?     @unique // E.164
  lineNumberId              String? // Telnyx phone_numbers resource id
  // The line's own Telnyx messaging profile (created when its 10DLC campaign is
  // filed) so STOP / START / HELP replies carry the business's name — carriers
  // require it; the shared TELNYX_MESSAGING_PROFILE_ID can only answer
  // generically. Null = still on the shared profile.
  lineMessagingProfileId    String?
  lineForwardTo             String? // E.164 cell that inbound calls ring (null = calls not forwarded yet)
  lineProvisionedAt         DateTime?
  lineType                  String? // "local" | "toll_free" — decides the texting registration path (10DLC vs toll-free verification)
  // Set when the add-on lapses while a number is attached: the number is
  // released to Telnyx at this instant unless the company resubscribes or
  // ports it out first (lib/business-line.ts runLineReleaseSweep). Null = keep.
  lineReleaseAt             DateTime?
  // Voice routing (lib/voice.ts): set once the number sits on the WorkBench
  // Call Control app — inbound calls are answered by us (whisper + press 1,
  // voicemail) instead of the number-level forwarding feature. Null = still
  // plain forwarding (TELNYX_VOICE_APP_ID unset, or not migrated yet).
  lineVoiceAppAt            DateTime?
  // Custom voicemail greeting read by TTS; null = the generated default.
  lineVoicemailGreeting     String?
  // Outbound caller-ID name (CNAM listing on the number at Telnyx): ≤15
  // uppercase alphanumerics/spaces, e.g. "STREAMFLAIRE". Set from the company
  // name when a number is provisioned/attached; editable in Settings. Null =
  // no listing (Telnyx refused it, or it was cleared).
  lineCallerIdName          String?
  // Softphone (lib/softphone.ts): the Telnyx credential connection every
  // team member's browser registers under. Created lazily the first time
  // someone opens the app with a routed line; deleted with the number.
  lineSipConnectionId       String?
  // Platform suspension (superadmin-only): set → the tenant app and public
  // booking/leads/payments are disabled, data stays intact until support
  // reinstates. Deletion is separate and permanent.
  suspendedAt               DateTime?
  suspendedReason           String?
  // Self-serve onboarding review: stamped when the company was created through
  // the public /apply flow and a person hasn't reviewed the application yet.
  // The app stays fully usable (banner warns access is provisional); approving
  // at /superadmin/applications clears it, rejecting suspends the company.
  // Null for invite-code signups and every pre-existing company.
  accessPendingAt           DateTime?
  // Team settings: who gets website/booking leads (null = company owner),
  // and whether SALES users can see invoices & payments for their leads.
  defaultLeadUserId         String?
  salesSeePayments          Boolean     @default(true)
  // Lead intake webhook (Zapier/Make/ad connectors): POST /api/public/leads/[token].
  // null = intake off; rotating the token kills old integrations instantly.
  leadWebhookToken          String?     @unique
  // Hide the board's Converted section (recently-won cards) to save screen space
  hideConvertedLeads        Boolean     @default(false)
  teamSize                  String? // onboarding answers below — analytics/marketing
  currentSoftware           String?
  topPriority               String?
  referralSource            String?
  // Custom sending domain (Resend Domains API): client emails send from
  // `${emailFromLocal}@${emailDomain}` once status is "verified"; every other
  // state falls back to the platform EMAIL_FROM. Rails only until the Resend
  // plan supports tenant domains — UI/API gate on EMAIL_DOMAINS_ENABLED.
  emailDomain               String?     @unique // apex or subdomain the company verified (e.g. "summitplumbing.com")
  emailDomainId             String? // Resend domain id — the handle for verify/status/delete
  emailDomainStatus         String? // Resend status mirror: "pending" | "verified" | "failed" | "temporary_failure"
  emailDomainRecords        Json? // DNS records Resend wants ([{record,name,type,value,status}]) — shown in Settings
  emailFromLocal            String? // local part of the From address; null = "notifications"
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  users                 User[]
  contacts              Contact[]
  requests              Request[]
  jobs                  Job[]
  quotes                Quote[]
  invoices              Invoice[]
  payments              Payment[]
  refunds               Refund[]
  workItems             WorkItem[]
  subscriptions         Subscription[]
  bookingRequests       BookingRequest[]
  reviewRequests        ReviewRequest[]
  appointments          Appointment[]
  contactFieldDefs      ContactFieldDef[]
  webForms              WebForm[]
  bookingTypes          BookingType[]
  estimators            Estimator[]
  libraryListings       EstimatorListing[]
  libraryLikes          EstimatorListingLike[]
  automations           Automation[]
  automationRuns        AutomationRun[]
  automationJobs        AutomationJob[]
  automationNotices     AutomationNotice[]
  contractTemplates     ContractTemplate[]
  contracts             Contract[]
  expenses              Expense[]
  recurringExpenses     RecurringExpense[]
  teamMessages          TeamMessage[]
  chatChannels          ChatChannel[]
  pipelineStages        PipelineStage[]
  timeBlocks            TimeBlock[]
  timeEntries           TimeEntry[]
  locationPings         LocationPing[]
  quickBooks            QuickBooksConnection?
  googleCalendars       GoogleCalendarConnection[]
  inviteCode            InviteCode?
  application           AccessApplication?
  clientMessages        ClientMessage[]
  feedbackTickets       FeedbackTicket[]
  portalMessages        PortalMessage[]
  messagingRegistration MessagingRegistration?
  calls                 Call[]

  @@index([slug])
}

// ─── Users ───────────────────────────────────────────────────────────────────

// One login per email address. An Account can hold memberships at several
// companies — each membership is a User row (which keeps its role, hourly
// cost, assignments, time entries, etc. scoped to that company). The session
// always points at ONE User row (the "active company"); switching companies
// re-points it. Identity (name, avatar, email, password) is account-level and
// fanned out to the member rows so every existing per-row read keeps working.
model Account {
  id                String    @id @default(cuid())
  email             String    @unique // always stored lowercased (lib/user-email.ts)
  // Null = no password yet: the account was opened with a social sign-in
  // (AccountIdentity) and has never set one. Password login refuses a null
  // hash; "Forgot password" is how such an account adds one.
  passwordHash      String?
  // The User row (membership) the last session used — sign-in lands here.
  // Plain string on purpose: memberships get deleted with their company, and
  // login falls back to the oldest active membership when this row is gone.
  lastActiveUserId  String?
  // Stamped by setPasswordForUser; sessions minted before it are stale
  // (lib/permissions.ts loadActor) — a reset evicts every older cookie.
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  users      User[]
  identities AccountIdentity[]
}

// A third-party sign-in (Google today, Apple next) bound to an Account. The
// provider's stable subject id is the key — never the email, which a person
// can change on the provider side. Matching by email happens exactly once, at
// first sign-in, and only when the provider vouches the address is verified
// (lib/social-login.ts).
model AccountIdentity {
  id                String    @id @default(cuid())
  accountId         String
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  provider          String // "google" | "apple"
  providerAccountId String // OIDC `sub`
  // Address the provider reported when linked — informational (support, the
  // Connected sign-ins card); the login address stays Account.email.
  email             String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime?

  @@unique([provider, providerAccountId])
  @@index([accountId])
}

model User {
  id               String    @id @default(cuid())
  email            String
  name             String
  // Legacy (pre-Account) login hash — Account.passwordHash is authoritative.
  // Kept nullable so old rows keep signing in until the backfill/first-login
  // lazily creates their Account (lib/account.ts).
  passwordHash     String?
  role             Role      @default(TECH)
  companyId        String?
  company          Company?  @relation(fields: [companyId], references: [id])
  accountId        String?
  account          Account?  @relation(fields: [accountId], references: [id])
  phone            String?
  isActive         Boolean   @default(true)
  // Accepts online-booking slots: this user's free time feeds the public slot
  // picker and tentative appointments land on them. Off by default — owners
  // opt team members in from the Team page.
  bookable         Boolean   @default(false)
  // Per-member weekly working hours (same JSON shape as Company.businessHours);
  // null = works the company's business hours. Feeds Find a Time, online
  // booking availability, and the route optimizer's default day start.
  workingHours     Json?
  // Online scheduling extras (Team page): a personal video-meeting room
  // pasted into video-call confirmations, and where this member starts the
  // day (geocoded like Company.address) so the first drive of the day is
  // measured from home instead of the shop. All null = shop pin.
  meetingLink      String?
  startAddress     String?
  startLat         Float?
  startLng         Float?
  startGeocodedAt  DateTime?
  // Profile picture (small client-resized square; same bytes-in-DB pattern
  // as Company.logoData — move to R2 with job photos when volume grows)
  avatarData       Bytes?
  avatarMime       String?
  avatarUpdatedAt  DateTime?
  // First-visit guided tour; null = hasn't seen it (fires on next dashboard visit)
  tourCompletedAt  DateTime?
  // Plain-text signature appended to client email messages (Settings → My
  // Profile); null = auto-generated from name + company details at send time
  emailSignature   String?   @db.Text
  // Team chat: last time this user opened the chat (drives the unread badge)
  chatLastSeenAt   DateTime?
  // Internal labor cost per hour — feeds job labor costing from time entries.
  // Never shown to techs (pricing gate); null = don't cost this user's time.
  hourlyCost       Decimal?  @db.Decimal(10, 2)
  // Softphone (lib/softphone.ts): business-line calls ring in the browser
  // while this person is signed in on a computer. Off = cell only.
  softphoneEnabled Boolean   @default(true)
  // Last heartbeat from a registered softphone; online = within the last
  // ~75 s (SOFTPHONE_PRESENCE_MS). Cleared when the tab closes cleanly.
  softphoneSeenAt  DateTime?
  // Per-user Telnyx telephony credential (under Company.lineSipConnectionId);
  // sipUsername is what Call Control dials (sip:<username>@sip.telnyx.com).
  // One credential per device kind: the browser's and the iPhone app's are
  // separate registrations at Telnyx, so a phone logging in never bumps the
  // desktop off the line and each gets exactly the leg meant for it.
  sipCredentialId     String?
  sipUsername         String?
  sipCredentialIdIos  String?
  sipUsernameIos      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assignments          JobAssignment[]
  notes                JobNote[]
  contactNotes         ContactNote[]
  clientMessages       ClientMessage[]
  assignedContacts     Contact[]                 @relation("AssignedContacts")
  appointments         Appointment[]             @relation("AppointmentAssignee")
  bookingTypeMembers   BookingTypeMember[]
  teamMessages         TeamMessage[]
  receivedTeamMessages TeamMessage[]             @relation("ReceivedTeamMessages")
  chatThreadStates     ChatThreadState[]
  chatChannelMembers   ChatChannelMember[]
  pushSubscriptions    PushSubscription[]
  passwordResetTokens  PasswordResetToken[]
  emailChangeTokens    EmailChangeToken[]
  superadminLoginCodes SuperadminLoginCode[]
  timeBlocks           TimeBlock[]               @relation("TimeBlockUser")
  timeEntries          TimeEntry[]
  locationPings        LocationPing[]
  checklistChecks      JobChecklistItem[]
  feedbackTickets      FeedbackTicket[]
  portalMessages       PortalMessage[]
  celebrationsSeen     CelebrationSeen[]
  calendarFeed         CalendarFeed?
  googleCalendar       GoogleCalendarConnection?
  calls                Call[]
  answeredCalls        Call[]                    @relation("AnsweredCalls")
  callLegs             CallLeg[]

  // Same address may exist at several companies (one row per membership),
  // but only once within a company.
  @@unique([email, companyId])
  @@index([companyId])
  @@index([role])
  @@index([accountId])
}

// Self-serve password reset. We store only a SHA-256 hash of the emailed token,
// so a database leak can't be used to reset anyone's password. Single-use
// (usedAt) and short-lived (expiresAt).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A requested — not yet applied — change of sign-in address. The new address
// only becomes real once its owner clicks the link from that inbox, so a typo
// can't lock someone out of their own account and a borrowed session can't
// quietly move the account somewhere else. One live request per user; issuing
// a new one replaces it.
model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Second factor for /superadmin/login: a 6-digit code emailed after the
// password checks out. SHA-256 hash only, one live code per user (issuing
// replaces), short-lived, consumed on successful sign-in, and attempt-capped
// so the 1M keyspace can't be walked.
model SuperadminLoginCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Push notifications ──────────────────────────────────────────────────────

// One row per browser/device a user turned notifications on for (a user can
// have several: phone app + desktop browser). Dead endpoints are pruned when
// the push service answers 404/410 on send.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Web: the push-service endpoint URL. Native (ios/android): the FCM device token.
  endpoint  String   @unique
  platform  String   @default("web") // "web" | "ios" | "android"
  // Web-push encryption keys — null for native subscriptions
  p256dh    String?
  auth      String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Team chat ───────────────────────────────────────────────────────────────

// A conversation: the built-in company-wide "Everyone" channel (one per
// company, no member rows — visibility is the whole company), or a
// member-created DM (2 members, name null) / group chat (2+ members, named).
// No DMs or groups exist until someone creates them.
model ChatChannel {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isEveryone    Boolean   @default(false)
  name          String? // groups only; DMs display the other member's name
  createdById   String?
  // Thread-list ordering without joining messages
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  members  ChatChannelMember[]
  messages TeamMessage[]

  @@index([companyId, lastMessageAt])
}

// Membership + per-channel read marker (the Everyone channel reuses
// User.chatLastSeenAt instead).
model ChatChannelMember {
  id         String      @id @default(cuid())
  channelId  String
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime?
  createdAt  DateTime    @default(now())

  @@unique([channelId, userId])
  @@index([userId])
}

// One chat message. channelId is the home of every message written since the
// channels rework; recipientId is the legacy pre-channels DM pointer, kept
// only so scripts/migrate-chat-channels.mjs can map old rows.
model TeamMessage {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channelId   String?
  channel     ChatChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientId String?
  recipient   User?        @relation("ReceivedTeamMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String
  editedAt    DateTime?
  // Soft delete: body is wiped, a "message deleted" tombstone stays in the thread
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())

  reactions TeamMessageReaction[]

  @@index([channelId, createdAt])
  @@index([companyId, recipientId, createdAt])
  @@index([recipientId, userId])
}

// iMessage-style tapbacks: one row per user+emoji per message, toggled off by
// deleting the row — storage stays tiny.
model TeamMessageReaction {
  id        String      @id @default(cuid())
  messageId String
  message   TeamMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// Per-DM-thread read markers (the company channel reuses User.chatLastSeenAt).
// threadKey = the DM peer's user id. One row per opened thread per user.
model ChatThreadState {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadKey  String
  lastSeenAt DateTime @default(now())

  @@unique([userId, threadKey])
}

enum Role {
  SUPERADMIN
  OWNER
  ADMIN // pretty much everything except managing owners/admins' roles
  USER // sales + tech combined, no admin powers (UI label: "Sales + Tech")
  SALES // sells: assigned leads, their requests/quotes
  TECH // performs: assigned jobs + schedule, no pricing
}

// ─── Public roadmap (Upcoming Features board) ────────────────────────────────

enum RoadmapCategory {
  FEATURE
  BUG
  QOL // quality of life
}

// Product-wide (not company-scoped): the public "what's coming / what shipped"
// board at /roadmap. Anyone can view; only the allowlisted editor accounts in
// lib/roadmap.ts can write.
model RoadmapItem {
  id           String          @id @default(cuid())
  category     RoadmapCategory
  title        String
  details      String? // public note — shows on the board for everyone
  privateNotes String? // editors-only note — stripped server-side for everyone else
  shippedAt    DateTime? // null = upcoming; set = shipped (the checkbox)
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  feedbackTickets FeedbackTicket[]

  @@index([category, shippedAt])
}

// ─── Support & suggestion tickets ────────────────────────────────────────────

enum FeedbackType {
  BUG
  SUGGESTION
}

enum FeedbackStatus {
  OPEN // awaiting platform review
  PLANNED // approved → posted to the Upcoming Features board
  RESOLVED // bug fixed / suggestion shipped, closed out
  DECLINED // reviewed, not doing it
}

// In-app "Help & feedback" tickets from tenant users: bug reports and
// feature/QOL suggestions. Reviewed in the superadmin console; approving one
// posts an (editable) RoadmapItem onto the public Upcoming Features board.
// The submitter follows status + the platform response on /app/support.
model FeedbackTicket {
  id            String         @id @default(cuid())
  type          FeedbackType
  status        FeedbackStatus @default(OPEN)
  title         String
  details       String         @db.Text
  pageUrl       String? // in-app path the user filed it from
  // Platform reply shown to the submitter on their tickets list
  response      String?        @db.Text
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Board item this ticket became when approved (approval snapshot lives there)
  roadmapItemId String?
  roadmapItem   RoadmapItem?   @relation(fields: [roadmapItemId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([companyId, userId, createdAt])
}

// ─── Contacts (Clients) ──────────────────────────────────────────────────────

enum ContactFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
}

// Company-defined custom fields on clients ("Gate code", "Property size").
// Definitions live here; each contact stores values in customFields Json
// keyed by definition id. Archiving (isActive=false) hides a field without
// destroying saved values.
model ContactFieldDef {
  id        String           @id @default(cuid())
  companyId String
  company   Company          @relation(fields: [companyId], references: [id])
  label     String
  type      ContactFieldType @default(TEXT)
  options   Json? // SELECT: string[] of choices
  required  Boolean          @default(false)
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())

  @@index([companyId, isActive])
}

enum ContactStatus {
  LEAD
  ACTIVE
  ARCHIVED
}

// ─── Lead pipeline (kanban board) ────────────────────────────────────────────

// App events that can auto-advance a lead's card to a stage claiming them.
// Cards only move FORWARD on triggers — a quote re-send never demotes a lead.
// CONTACT_MADE = a call with them connects (either direction) or the team
// texts them from the Messages thread; CALL_NO_ANSWER = an outbound call
// ends without them picking up (lib/voice.ts pipelineTriggerForCall).
enum PipelineTrigger {
  REQUEST_CREATED
  CONTACT_MADE
  CALL_NO_ANSWER
  APPOINTMENT_SCHEDULED
  QUOTE_SENT
  QUOTE_APPROVED
}

// One column on the company's Leads board. Fully customizable: rename,
// recolor, reorder, add, delete (delete moves its cards to the first stage).
// Defaults seed on first board visit — see lib/pipeline.ts.
model PipelineStage {
  id            String           @id @default(cuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id])
  name          String
  color         String? // hex accent for the column header; null = console ink
  sortOrder     Int              @default(0)
  // The built-in terminal "Converted" section (one per company, always last,
  // undeletable): quote approvals and other wins land cards here while the
  // contact becomes an ACTIVE client. Hidden via Company.hideConvertedLeads.
  isConverted   Boolean          @default(false)
  autoAdvanceOn PipelineTrigger?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  contacts Contact[]

  @@index([companyId, sortOrder])
}

model Contact {
  id                   String         @id @default(cuid())
  companyId            String
  company              Company        @relation(fields: [companyId], references: [id])
  firstName            String
  lastName             String
  companyName          String? // the client's business name (CRM imports usually have one)
  email                String?
  phone                String?
  // Digits-only copy of `phone` (last 10 for US numbers) kept in sync by the
  // Contact write hook in lib/db.ts — duplicate matching and inbound-SMS
  // routing compare on this, never on the freeform column.
  phoneDigits          String?
  address              String?
  city                 String?
  state                String?
  zip                  String?
  notes                String?
  status               ContactStatus  @default(LEAD)
  leadSource           String?
  // Lead pipeline (kanban): a set stage = a card on the Leads board. LEAD
  // contacts always carry a stage; ACTIVE clients re-enter when they submit
  // a new request (their card shows a Repeat badge). Won clears the stage and
  // stamps wonAt; Lost clears it with a reason (leads also archive).
  pipelineStageId      String?
  pipelineStage        PipelineStage? @relation(fields: [pipelineStageId], references: [id])
  pipelineOrder        Int            @default(0) // manual sort within the column
  stageChangedAt       DateTime? // drives the card's "Nd in stage" aging
  wonAt                DateTime? // last win — insights funnel
  timesWon             Int            @default(0) // Repeat badge = won before the current run
  lostAt               DateTime?
  lostReason           String?
  // Lead ownership: SALES/USER roles only see contacts assigned to them
  assignedToId         String?
  assignedTo           User?          @relation("AssignedContacts", fields: [assignedToId], references: [id])
  // CSV import provenance — lets "Undo this import" find the batch
  importBatchId        String?
  // Values for the company's ContactFieldDef custom fields: { [defId]: value }
  customFields         Json?
  paymentTermsDays     Int            @default(30)
  // Payment processor's vaulted card (Finix payment instrument, PIxxx) —
  // set when the client checks "save this card" on /pay or adds a card in the
  // client hub. Recurring billing auto-charges when set; staff can charge it
  // from an invoice ("Charge card on file").
  processorCustomerRef String?
  // Display-only metadata for the saved card ("Visa •••• 4242 · exp 12/27")
  // and when it was saved — never used for charging.
  savedCardLabel       String?
  savedCardAt          DateTime?
  // Finix buyer Identity (IDxxx) — created on the contact's first online
  // payment (or first saved card) and reused after. NOT a chargeable token
  // (that's processorCustomerRef).
  finixBuyerIdentityId String?
  // Provider SMS (Telnyx): set when the client texts STOP to our number —
  // automated texts (reminders, quote/invoice links) skip them. Telnyx also
  // blocks at their edge; this flag keeps our senders honest and visible.
  smsOptOut            Boolean        @default(false)
  // Texts are ON by default for any client with a phone on file: reminders,
  // schedule changes and quote/invoice links are informational, so the number
  // the client gave the business is the consent (the company attests to that
  // once — Company.smsAcknowledgedAt). smsDisabled = staff switched texts off
  // for this client, or the client left the SMS box unchecked when a booking
  // form created them. lib/sms-consent.ts canText() is the one gate.
  smsDisabled          Boolean        @default(false)
  // Audit trail of an explicit opt-in, when there was one: the client ticked
  // the SMS box on a booking form, or staff switched texts back on. Not
  // required to text — see smsDisabled.
  smsConsentAt         DateTime?
  smsConsentSource     String? // "booking" | "hub" | "manual" | "booking_declined"
  smsConsentNote       String? // how the client agreed, when staff recorded it
  hubToken             String         @unique @default(cuid())
  // Last time the client opened their hub (beacon-stamped, no push — shown on
  // the contact page as "Portal · last visit")
  hubLastVisitAt       DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  requests          Request[]
  jobs              Job[]
  quotes            Quote[]
  invoices          Invoice[]
  payments          Payment[]
  subscriptions     Subscription[]
  bookingRequests   BookingRequest[]
  appointments      Appointment[]
  contracts         Contract[]
  contactNotes      ContactNote[]
  addresses         ContactAddress[]
  people            ContactPerson[]
  clientMessages    ClientMessage[]
  portalMessages    PortalMessage[]
  pushSubscriptions ContactPushSubscription[]
  savedCards        SavedCard[]
  calls             Call[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, lastName])
  @@index([companyId, assignedToId])
  @@index([companyId, importBatchId])
  @@index([companyId, pipelineStageId])
  @@index([companyId, phoneDigits])
}

// A vaulted card on a client's account (Finix payment instrument, PIxxx).
// Multiple cards per contact; exactly one is the default — recurring billing
// and one-tap staff charges use the default, staff can pick another at charge
// time. The legacy Contact.processorCustomerRef/savedCardLabel/savedCardAt
// columns mirror the default card (kept in sync by syncDefaultCardMirror) so
// nothing that still reads them breaks.
model SavedCard {
  id                String    @id @default(cuid())
  companyId         String
  contactId         String
  contact           Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  instrumentRef     String // Finix PIxxx — the chargeable vault token
  label             String // "Visa •••• 4242 · exp 12/27" (display only)
  brand             String?
  last4             String?
  expMonth          Int?
  expYear           Int?
  isDefault         Boolean   @default(false)
  // "Your card expires soon" email sent (once per card row — a re-vaulted
  // card with a new expiry lands as a fresh row). See runCardExpiryNudges.
  expiryNudgeSentAt DateTime?
  createdAt         DateTime  @default(now())

  // Series whose autopay is pinned to this card (Subscription.savedCardId)
  subscriptions Subscription[]

  @@unique([contactId, instrumentRef])
  @@index([contactId])
  @@index([companyId])
}

// Additional service addresses (rental properties, second locations, ...).
// The contact's flat address/city/state/zip stays the primary; these are
// extras, offered wherever a job/appointment address gets picked.
model ContactAddress {
  id         String    @id @default(cuid())
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label      String? // "Rental on 5th St", "Office", ...
  address    String
  city       String?
  state      String?
  zip        String?
  // Forward-geocoded pin for this property (lib/geocoding.ts) — what the
  // Route Manager plots. Cleared whenever the address text changes; null =
  // not geocoded yet, geocoding disabled, or the address didn't resolve.
  lat        Float?
  lng        Float?
  geocodedAt DateTime?
  createdAt  DateTime  @default(now())

  // Work linked to this property (per-property history)
  jobs          Job[]
  appointments  Appointment[]
  quotes        Quote[]
  subscriptions Subscription[]

  @@index([contactId])
}

// Global forward-geocode cache — one row per normalized address string,
// shared across tenants (a street address is not a tenant secret, and Mapbox
// bills per lookup, so every company benefits from every hit). "ok" rows
// carry coordinates; "failed" rows negative-cache strings that didn't
// resolve so route loads don't re-spend quota retrying them.
model GeocodeCache {
  id        String   @id @default(cuid())
  query     String   @unique // normalized: lowercased, whitespace-collapsed one-liner
  lat       Float?
  lng       Float?
  status    String // "ok" | "failed"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Other people who belong to the same client: a second decision-maker at a
// business, or a spouse on a residential account. They are NOT their own
// client — one record still owns all the work, quotes and invoices, so the
// history stays in one place. The Contact's own name/email/phone remain the
// primary; these are the extra people you'd also call or email.
model ContactPerson {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  role      String? // "Office manager", "Spouse", "Property manager", ...
  email     String?
  phone     String?
  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
}

// ─── Requests ────────────────────────────────────────────────────────────────

enum RequestStatus {
  NEW
  NEEDS_APPROVAL // self-scheduled booking awaiting Accept and Schedule / Decline
  CONVERTED
  ARCHIVED
}

model Request {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  contactId     String
  contact       Contact       @relation(fields: [contactId], references: [id])
  requestNumber Int
  title         String
  details       String?
  status        RequestStatus @default(NEW)
  preferredDate DateTime? // client's requested date from booking-type forms (date-only, noon anchor)
  source        String        @default("internal") // internal | client_hub | booking_form | estimate_form | webhook
  // Online scheduling: the booking type the customer picked (null = classic form)
  bookingTypeId String?
  bookingType   BookingType?  @relation(fields: [bookingTypeId], references: [id], onDelete: SetNull)
  // Website estimate form the request came from (source estimate_form)
  estimatorId   String?
  estimator     Estimator?    @relation(fields: [estimatorId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  quotes       Quote[]
  jobs         Job[]
  appointments Appointment[]

  @@unique([companyId, requestNumber])
  @@index([companyId])
  @@index([companyId, status])
}

// ─── Business expenses (owner/admin: profit tracking + CSV export) ───────────

model Expense {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  description String
  category    String?
  amount      Decimal  @db.Decimal(10, 2)
  incurredAt  DateTime // transaction date (date-only, noon anchor)
  createdById String?
  createdAt   DateTime @default(now())
  // Drives QBO re-push change detection (same pattern as Invoice.updatedAt)
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([companyId, incurredAt])
}

// A standing monthly expense (rent, insurance, software…). The daily cron
// posts a real Expense row on each due date and advances nextRunDate, so the
// log stays the single source of truth — templates never count toward totals.
model RecurringExpense {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  description String
  category    String?
  amount      Decimal  @db.Decimal(10, 2)
  // Posts on this day each month, clamped to the month's last day (31 → Feb 28)
  dayOfMonth  Int
  // Next date this template posts (noon anchor, like Expense.incurredAt).
  // The sweep claims a template by compare-and-swapping this forward, so two
  // overlapping cron runs can't double-log.
  nextRunDate DateTime
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([companyId])
  @@index([active, nextRunDate])
}

// ─── Client notes (same shape as job notes) ──────────────────────────────────

model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([contactId])
}

// A one-off professional email to a client, composed on the contact page.
// The email carries the subject plus a "Read message" button; the BODY lives
// on the public /message/[token] page, so opens are tracked by the same view
// beacon as quotes/invoices (no tracking pixels — deliverability). Replies
// are ordinary email replies (Reply-To = the company inbox).
model ClientMessage {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?     @relation(fields: [senderId], references: [id])
  subject        String
  body           String    @db.Text
  // Signature as it went out (snapshot — later profile edits don't rewrite
  // sent mail); shown under the body on the public message page too
  signature      String?   @db.Text
  publicToken    String    @unique @default(cuid())
  firstViewedAt  DateTime?
  lastViewedAt   DateTime?
  viewCount      Int       @default(0)
  // Email-open pixel (HubSpot-style, honestly labeled): first pixel load that
  // survived scanner filtering. Kind "confident" = a real mail client fetched
  // images (Gmail proxy, Outlook after download-images); "likely" = Apple's
  // privacy proxy, which auto-loads images — may not be an actual read.
  emailOpenedAt  DateTime?
  emailOpenKind  String? // "confident" | "likely"
  // The one open push per message has been sent (confident pixel OR page
  // view, whichever lands first) — "likely" signals never push.
  openNotifiedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([companyId])
  @@index([contactId])
}

// ─── Portal messaging (two-way client ↔ company thread) ──────────────────────

enum PortalMessageDirection {
  INBOUND // from the client (hub composer or an inbound SMS)
  OUTBOUND // from the company (team inbox reply)
}

// One chat-style thread per contact. Distinct from ClientMessage (one-off
// professional EMAILS with open tracking) — these are short back-and-forth
// messages surfaced in the client hub's Messages tab and the team's
// /app/messages inbox. `via` records the transport the message arrived on;
// outbound messages always originate in the app (the SMS/email/push copies
// are notifications pointing back at the thread, not separate messages).
model PortalMessage {
  id             String                 @id @default(cuid())
  companyId      String
  company        Company                @relation(fields: [companyId], references: [id])
  contactId      String
  contact        Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  direction      PortalMessageDirection
  // Team user who sent an OUTBOUND message; null for INBOUND
  senderId       String?
  sender         User?                  @relation(fields: [senderId], references: [id])
  body           String                 @db.Text
  via            String                 @default("portal") // "portal" | "sms"
  // Read state, one side each: INBOUND rows get readByTeamAt when the team
  // opens the thread; OUTBOUND rows get readByClientAt when the hub loads it
  readByTeamAt   DateTime?
  readByClientAt DateTime?
  createdAt      DateTime               @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, direction, readByTeamAt])
  @@index([contactId, createdAt])
}

// Web-push subscriptions for CLIENTS (contacts) — the hub counterpart of
// PushSubscription (which targets team users). One row per browser/device the
// client turned notifications on for; dead endpoints pruned on send.
model ContactPushSubscription {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([contactId])
}

// ─── Service contracts (templates + e-sign) ──────────────────────────────────

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  VOID
}

// Reusable contract text the company writes once ("Lawn Care Agreement").
// {{client_name}}, {{company_name}}, {{date}} placeholders fill at creation.
model ContractTemplate {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  body      String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts Contract[]
  workItems WorkItem[]

  @@index([companyId, isActive])
}

// A contract issued to a client — body snapshotted from the template, signed
// with a typed signature on the public /contract/[token] page (same e-sign
// approach as quote approval: typed name + timestamp + IP).
model Contract {
  id             String            @id @default(cuid())
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id])
  contactId      String
  contact        Contact           @relation(fields: [contactId], references: [id])
  templateId     String?
  template       ContractTemplate? @relation(fields: [templateId], references: [id])
  // Agreement attached to a specific quote — gates quote→job conversion when
  // the quote contains agreement-requiring services
  quoteId        String?
  quote          Quote?            @relation(fields: [quoteId], references: [id])
  // Per-company agreement number. Nullable so db push stays additive on
  // existing rows; scripts/backfill-doc-numbers.mjs fills history on boot and
  // new creates assign max+1 (multiple NULLs never trip a composite unique).
  contractNumber Int?
  title          String
  body           String            @db.Text
  status         ContractStatus    @default(DRAFT)
  publicToken    String            @unique @default(cuid())
  sentAt         DateTime?
  // Client opened the public /contract page (beacon-stamped — see /api/public/viewed)
  firstViewedAt  DateTime?
  lastViewedAt   DateTime?
  viewCount      Int               @default(0)
  signatureName  String?
  signedAt       DateTime?
  signedFromIp   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([companyId, contractNumber])
  @@index([companyId, status])
  @@index([contactId])
}

// ─── Web forms (public booking/inquiry/service-request forms) ────────────────

enum WebFormType {
  INQUIRY // collect info → lead + request
  BOOKING // + preferred date for an estimate
  SERVICE_REQUEST // pick services → auto-creates an invoice (draft or sent)
}

// A company can run any number of public forms, each fully customizable
// (header, every field label, appearance). The company's pre-multi-form
// config (Company.bookingForm Json) is lazily migrated into the row marked
// isDefault, which keeps the original /book/[slug] and /embed/[slug] URLs
// (and snippets already on customer sites) working unchanged.
model WebForm {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id])
  name      String // internal label, also the request title fallback
  slug      String // URL part: /book/[companySlug]/[slug]
  type      WebFormType @default(INQUIRY)
  isDefault Boolean     @default(false)
  isActive  Boolean     @default(true)
  config    Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([companyId, slug])
  @@index([companyId])
}

// ─── Booking types (online scheduling — Calendly-style "event types") ────────

// What a customer can pick on the public booking pages. Calls promise an
// exact start; in-person kinds promise an arrival window; SERVICE books
// price-book work (an approved quote → scheduled job, optionally paid).
enum BookingKind {
  PHONE_CALL
  VIDEO_CALL
  IN_PERSON // estimate / consult at the customer's address
  SERVICE // customer picks services from the price book
  MESSAGE // a plain "contact us" form — no scheduling, no services
}

// How an item is fulfilled: the customer picks a real time (engine), or they
// leave a request and the business follows up (the pre-v2 web-form flow).
enum BookingMode {
  SCHEDULE
  REQUEST
}

enum BookingConfirmation {
  INSTANT // confirmed on the spot
  APPROVAL // tentative until the business accepts (Request.NEEDS_APPROVAL)
}

enum BookingPayment {
  NONE
  DEPOSIT // each service's deposit rule (company default fallback)
  FULL // whole amount at booking (DepositType.FULL on the quote)
}

enum BookingAssignment {
  ROUND_ROBIN // whoever is free, then least recently assigned
  PRIORITY // member priority first, then least recently assigned
}

// AI-built estimate tools (docs/plans/ai-estimators-2026-09-19.md). `spec`
// is a declarative EstimatorSpec (lib/estimator.ts): inputs, named
// variables, and line-item rules written in a small safe expression
// language. Atlas WRITES the spec (costs tokens once); RUNNING it is plain
// code and free. A spec may opt into an Atlas-assisted step ("describe the
// job, Atlas fills in the inputs") which is metered per use.
model Estimator {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  description  String?
  spec         Json
  isActive     Boolean  @default(true)
  runs         Int      @default(0) // deterministic runs (free)
  assists      Int      @default(0) // Atlas-assisted runs (metered)
  // Website form (docs/plans/ai-estimators-2026-09-19.md, Batch 3): the same
  // tool served publicly at /book/[companySlug]/estimate/[publicSlug] and in
  // an iframe — visitors answer the questions, see an estimate (exact / range /
  // hidden, per publicConfig) and leave their details, which becomes a lead +
  // request (+ quote). publicConfig = EstimatorPublicConfig (lib/estimator-public.ts).
  isPublic     Boolean  @default(false)
  publicSlug   String?
  publicConfig Json?
  publicViews  Int      @default(0) // form loads
  publicCalcs  Int      @default(0) // estimates shown
  submissions  Int      @default(0) // leads captured
  // The Library listing this tool was copied from (plain id, no FK — the
  // listing may be unlisted or removed later; the copy stays).
  sourceListingId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests Request[]
  versions EstimatorVersion[]
  images   EstimatorImage[]
  listing  EstimatorListing?
  quotes   Quote[]

  @@unique([companyId, publicSlug])
  @@index([companyId])
}

// The Library (docs/plans/ai-estimators-2026-09-19.md, Batch 10): a tool
// shared with every Workbench business, anonymously or under the company's
// name. `spec` is a PORTABLE snapshot taken at share time
// (lib/estimator-portable.ts: price-book links inlined as literal rates, all
// rates listed as "rates to confirm") so it compiles in any company. Adding
// one creates a separate Estimator row for the adopter; unlisting (HIDDEN) or
// a Workbench takedown (REMOVED) only stops the listing showing.
model EstimatorListing {
  id            String    @id @default(cuid())
  estimatorId   String    @unique
  estimator     Estimator @relation(fields: [estimatorId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  name          String
  description   String
  industry      String
  anonymous     Boolean   @default(false)
  byName        String? // company name snapshot; null when anonymous
  spec          Json
  likes         Int       @default(0)
  adds          Int       @default(0)
  status        String    @default("LIVE") // LIVE | HIDDEN (owner unlisted) | REMOVED (Workbench takedown)
  removedReason String?
  removedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  likeRows EstimatorListingLike[]

  @@index([status, industry, likes])
  @@index([companyId])
}

// One like per company per listing; the listing's `likes` counter is kept in step inside a transaction.
model EstimatorListingLike {
  id        String           @id @default(cuid())
  listingId String
  listing   EstimatorListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  companyId String
  company   Company          @relation(fields: [companyId], references: [id])
  createdAt DateTime         @default(now())

  @@unique([listingId, companyId])
}

// One run of the estimate-tool builder (lib/estimator-build-jobs.ts). The
// build keeps going on the server after the request that started it
// returns, appending its events here; the page polls this row, so the owner
// can navigate away mid-build and the tool still lands. status: running |
// questions (waiting on the owner's answers) | done (toolId set) | error.
// A row still "running" with no update for a few minutes was interrupted
// (server restart) and reads as an error.
model EstimatorBuild {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  estimatorId String? // set = a change to an existing tool
  prompt      String
  status      String   @default("running")
  events      Json     @default("[]")
  toolId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, status, updatedAt])
}

// Pictures on an estimate tool's questions/options (website form + runner).
// Public by nature (they render on the public form), served through
// /api/estimate-images/[id]; bytes in R2 when configured, else in the row —
// the same two-path scheme as JobPhoto.
model EstimatorImage {
  id          String    @id @default(cuid())
  companyId   String
  estimatorId String
  estimator   Estimator @relation(fields: [estimatorId], references: [id], onDelete: Cascade)
  mimeType    String
  data        Bytes?
  storageKey  String?
  sizeBytes   Int
  createdAt   DateTime  @default(now())

  @@index([estimatorId])
}

// Every saved change to an estimate tool (Atlas card, manual editor, restore)
// keeps the PREVIOUS spec here, so a bad rewrite is one click to undo.
// Trimmed to the last ESTIMATOR_VERSION_KEEP per tool (lib/estimator-server.ts).
model EstimatorVersion {
  id          String    @id @default(cuid())
  estimatorId String
  estimator   Estimator @relation(fields: [estimatorId], references: [id], onDelete: Cascade)
  companyId   String
  name        String
  description String?
  spec        Json
  // What made this the past: "Atlas update", "Manual edit", "Restored version from ..."
  note        String
  byUserId    String?
  byName      String?
  createdAt   DateTime  @default(now())

  @@index([estimatorId, createdAt])
}

// Owner-built automations (docs/plans/ai-estimators-2026-09-19.md, Batch 2).
// `spec` is a declarative AutomationSpec (lib/automations.ts): one trigger
// (an app event, or a time-based sweep with a day count), an optional
// condition expression, and an allowlisted action list. Atlas writes the
// spec; lib/automations-server.ts executes it. Nothing in the allowlist
// moves money, deletes, or changes the team.
model Automation {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  name        String
  description String?
  spec        Json
  isActive    Boolean   @default(true)
  // Whose behalf actions run under (notes, email sender). Plain id, no FK,
  // so the rule survives the person leaving.
  createdById String?
  runs        Int       @default(0)
  lastRunAt   DateTime?
  // Inbound webhook trigger: the secret in POST /api/public/automations/<token>.
  // Minted on save when the trigger is webhook.received; null otherwise.
  webhookToken String?  @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  runLog AutomationRun[]
  jobs   AutomationJob[]

  @@index([companyId])
}

// One row per (automation, entity, event) — the dedupe key that keeps a
// sweep from re-firing every hour and the audit trail the settings page shows.
// A team notification an automation sent — the push only shows a line or
// two on a phone, so the full text lives here and the bell feed reads it.
model AutomationNotice {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  userId       String
  automationId String?
  title        String
  body         String?
  url          String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([companyId, createdAt])
}

model AutomationRun {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  event        String
  entityType   String
  entityId     String
  status       String // "ok" | "skipped" | "failed"
  detail       String?
  createdAt    DateTime   @default(now())

  @@index([companyId, createdAt])
  @@index([automationId, entityId, event])
}

// A run parked at a "wait" step (lib/automations-server.ts). The hourly
// resume sweep picks up rows whose resumeAt has passed, reloads the record
// fresh, and carries on from nextStep on the SAME AutomationRun row. Pausing
// or deleting the automation cancels its waiting jobs.
model AutomationJob {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  runId        String
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  event        String
  entityType   String
  entityId     String
  nextStep     Int
  resumeAt     DateTime
  status       String // "waiting" | "done" | "cancelled"
  // webhook.received runs keep their payload here so a resumed run still
  // has its data_* fields
  payload      Json?
  createdAt    DateTime   @default(now())

  @@index([status, resumeAt])
  @@index([automationId])
}

model BookingType {
  id                   String              @id @default(cuid())
  companyId            String
  company              Company             @relation(fields: [companyId], references: [id])
  name                 String
  slug                 String // URL part: /book/[companySlug]/schedule/[slug]
  description          String?
  kind                 BookingKind
  isActive             Boolean             @default(true)
  sortOrder            Int                 @default(0)
  // Timing
  durationMinutes      Int                 @default(30)
  stepMinutes          Int                 @default(30) // candidate-start granularity (calls: 15/30/60)
  bufferBeforeMinutes  Int                 @default(0)
  bufferAfterMinutes   Int                 @default(0)
  leadHours            Int                 @default(4) // earliest offered slot = now + leadHours
  horizonDays          Int                 @default(30)
  maxPerDay            Int? // per member, this type; null = no cap
  maxShownPerDay       Int                 @default(6) // arrival-window kinds sample evenly; calls list every step
  confirmation         BookingConfirmation @default(INSTANT)
  // In-person: promised window width; null = company default, 0 = exact
  arrivalWindowMinutes Int?
  // Video: fallback link when the assigned member has none of their own
  meetingLink          String?
  paymentMode          BookingPayment      @default(NONE)
  assignment           BookingAssignment   @default(ROUND_ROBIN)
  // Client self-serve links in the confirmation email (calls by default)
  clientCanReschedule  Boolean             @default(false)
  clientCanCancel      Boolean             @default(false)
  cutoffHours          Int                 @default(24)
  // Online booking v3: one list of bookable items. REQUEST items are the old
  // web forms (no time picker); showOnPage hides link-only items from the
  // company's booking menu; intake = questions + words (lib/booking-intake.ts);
  // legacyFormId = the WebForm row this item was migrated from.
  mode                 BookingMode         @default(SCHEDULE)
  showOnPage           Boolean             @default(true)
  intake               Json?
  legacyFormId         String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  members      BookingTypeMember[]
  services     BookingTypeService[]
  appointments Appointment[]
  jobs         Job[]
  requests     Request[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([legacyFormId])
}

// The pool: who takes bookings of this type. lastAssignedAt drives round
// robin (least recently assigned wins among the free); priority only
// matters in PRIORITY assignment mode (higher first).
model BookingTypeMember {
  bookingTypeId  String
  bookingType    BookingType @relation(fields: [bookingTypeId], references: [id], onDelete: Cascade)
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  priority       Int         @default(0)
  lastAssignedAt DateTime?

  @@id([bookingTypeId, userId])
  @@index([userId])
}

// SERVICE kinds: the price-book items a customer can pick. Price, duration,
// deposit and agreement rules stay on WorkItem.
model BookingTypeService {
  bookingTypeId String
  bookingType   BookingType @relation(fields: [bookingTypeId], references: [id], onDelete: Cascade)
  workItemId    String
  workItem      WorkItem    @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  sortOrder     Int         @default(0)

  @@id([bookingTypeId, workItemId])
  @@index([workItemId])
}

// ─── Appointments (sales meetings / estimates)───────────────────────────────

enum AppointmentType {
  PHONE_CALL
  VIDEO_CALL
  IN_PERSON
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// A scheduled conversation with a client — estimate visit, sales call,
// discovery meeting. Sits between Request and Quote in the lifecycle and
// shows on the schedule next to jobs. Replaces Request.assessmentAt.
model Appointment {
  id                   String            @id @default(cuid())
  companyId            String
  company              Company           @relation(fields: [companyId], references: [id])
  contactId            String
  contact              Contact           @relation(fields: [contactId], references: [id])
  requestId            String?
  request              Request?          @relation(fields: [requestId], references: [id])
  assignedToId         String?
  assignedTo           User?             @relation("AppointmentAssignee", fields: [assignedToId], references: [id])
  // Per-company appointment number (nullable — backfilled on boot, see
  // scripts/backfill-doc-numbers.mjs; new creates assign max+1).
  appointmentNumber    Int?
  title                String // "Estimate", "Sales call", ...
  type                 AppointmentType
  status               AppointmentStatus @default(SCHEDULED)
  scheduledAt          DateTime
  scheduledEnd         DateTime?
  // Date-only scheduling: anchored at noon, shown in the calendar's "Anytime" row
  scheduledAnytime     Boolean           @default(false)
  // Per-appointment arrival-window override (lib/arrival-window.ts): null =
  // company default, 0 = exact time. Only meaningful for IN_PERSON — calls
  // always promise the exact time.
  arrivalWindowMinutes Int?
  // Self-scheduled online booking awaiting owner approval. Renders dashed on
  // the schedule; blocks the slot until accepted (clears this) or declined
  // (cancels the appointment). Internal creates are never tentative.
  tentative            Boolean           @default(false)
  // Online scheduling: which booking type this came through, when the
  // customer booked it, and the signed token behind their reschedule/cancel
  // links (null = internal create / self-serve off for that type).
  bookingTypeId        String?
  bookingType          BookingType?      @relation(fields: [bookingTypeId], references: [id], onDelete: SetNull)
  bookedOnlineAt       DateTime?
  manageToken          String?           @unique
  address              String? // required for IN_PERSON (API-enforced)
  // Saved service address this appointment is at (see Job.propertyId)
  propertyId           String?
  property             ContactAddress?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  meetingLink          String? // optional pasted URL for VIDEO_CALL
  notes                String?
  completedAt          DateTime?
  // Client reminder emails/texts: each stage fires once, tracked here like
  // PaymentReminder rows track dunning stages. Covers online-booked AND
  // manually created appointments; remindClient=false opts one appointment out
  // (internal meetings, clients who asked not to be messaged).
  remindClient         Boolean           @default(true)
  reminderDaySentAt    DateTime?
  reminderHourSentAt   DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([companyId, appointmentNumber])
  @@index([companyId, scheduledAt])
  @@index([companyId, status])
  @@index([contactId])
}

// ─── Time blocks ──────────────────────────────────────────────────────────────

// Blocked-off time on the schedule — personal ("dentist", day off) or, when
// userId is null, company-wide (holiday, team meeting; owners/admins only).
// Blocks render striped on the calendar and subtract from online-booking
// availability like any other busy interval.
enum TimeBlockSource {
  MANUAL // made in Workbench
  GOOGLE // mirrored from the user's Google Calendar (lib/google-calendar-pull.ts)
}

model TimeBlock {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  // null = everyone in the company
  userId      String?
  user        User?           @relation("TimeBlockUser", fields: [userId], references: [id], onDelete: Cascade)
  createdById String
  title       String          @default("Blocked off")
  // All-day blocks still store the full day span (00:00 → 23:59:59) so the
  // booking-availability math needs no special case; the flag only moves
  // rendering into the calendar's "Anytime" row.
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean         @default(false)
  // Optional "where I'll be" (dentist, supplier run, a personal errand) so
  // the route engine can drive to and from it: Find a Time and the
  // calendar's drive gaps treat a located block like a fixed stop.
  address     String?
  lat         Float?
  lng         Float?
  // Two-way calendar sync: GOOGLE blocks mirror one event in the user's own
  // Google Calendar (externalId = the Google event id). Read-only in the app
  // — the pull rewrites/deletes them — and never pushed back out.
  source      TimeBlockSource @default(MANUAL)
  externalId  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([companyId, startAt])
  @@index([userId])
  @@index([userId, source, externalId])
}

// ─── Jobs ─────────────────────────────────────────────────────────────────────

enum JobStatus {
  ACTIVE
  REQUIRES_INVOICING
  ARCHIVED
}

model Job {
  id                      String          @id @default(cuid())
  companyId               String
  company                 Company         @relation(fields: [companyId], references: [id])
  contactId               String
  contact                 Contact         @relation(fields: [contactId], references: [id])
  requestId               String?
  request                 Request?        @relation(fields: [requestId], references: [id])
  // Set when this job was auto-generated by a recurring subscription cycle
  subscriptionId          String?
  subscription            Subscription?   @relation(fields: [subscriptionId], references: [id])
  // The monthly consolidated invoice that billed this visit (many visits →
  // one invoice, distinct from the one-invoice-per-job `invoice` relation).
  // Null + completed + no direct invoice = still in the unbilled pool.
  consolidatedInvoiceId   String?
  consolidatedInvoice     Invoice?        @relation("ConsolidatedVisits", fields: [consolidatedInvoiceId], references: [id], onDelete: SetNull)
  jobNumber               Int
  title                   String
  description             String?
  leadSource              String?
  status                  JobStatus       @default(ACTIVE)
  scheduledAt             DateTime?
  scheduledEnd            DateTime?
  // Date-only scheduling: scheduledAt anchored at T12:00, shown in the
  // calendar's "Anytime" row rather than at a clock position.
  scheduledAnytime        Boolean         @default(false)
  // Per-job arrival-window override (lib/arrival-window.ts): null = the
  // company default (Company.arrivalWindowMinutes), 0 = promise the exact
  // start time. Techs always see exact times — this only changes what the
  // client is told (hub, reminders, on-my-way).
  arrivalWindowMinutes    Int?
  // Client visit reminders (same day-before + ~1-hour machinery as
  // Appointment — see runVisitReminders in lib/reminders.ts)
  remindClient            Boolean         @default(true)
  reminderDaySentAt       DateTime?
  reminderHourSentAt      DateTime?
  // Crew heads-up push ~1h before the visit (runTechHeadsUp) — independent of
  // the client reminder so techs still hear about remindClient=false jobs
  techHeadsUpSentAt       DateTime?
  // Background-generated visits can land on top of existing work with nobody
  // watching — generateDueVisits stamps the first conflict label here so the
  // schedule can badge it; any schedule/crew edit clears it (a human looked).
  conflictNote            String?
  // Online scheduling: booked by the customer through this booking type
  // (SERVICE kind). Schedule chips stamp "Booked online".
  bookingTypeId           String?
  bookingType             BookingType?    @relation(fields: [bookingTypeId], references: [id], onDelete: SetNull)
  bookedOnlineAt          DateTime?
  completedAt             DateTime?
  closedAt                DateTime?
  address                 String?
  // Which saved service address (property) this job is at. The address string
  // above stays the display/search snapshot; this id is the grouping key for
  // per-property history. Null = the contact's primary address or free text.
  propertyId              String?
  property                ContactAddress? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  // Last time a tech sent the client an "on my way" text (from their own phone)
  onMyWaySentAt           DateTime?
  // On-site completion sign-off: the client types their name on the tech's
  // phone when the work wraps (same typed-signature convention as quote
  // approval). Proof-of-completion for disputes.
  completionSignatureName String?
  completionSignedAt      DateTime?
  // Work handed to a subcontractor: nobody on the team is on it. The one way
  // a scheduled job may stand without a crew (lib/job-crew.ts insists on one
  // everywhere else), and it stays off everyone's calendar sync.
  outsourced              Boolean         @default(false)
  outsourcedTo            String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  assignments    JobAssignment[]
  notes          JobNote[]
  photos         JobPhoto[]
  lineItems      JobLineItem[]
  timeEntries    TimeEntry[]
  checklistItems JobChecklistItem[]
  quote          Quote?
  invoice        Invoice?

  @@unique([companyId, jobNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, scheduledAt])
}

model JobLineItem {
  id                String             @id @default(cuid())
  jobId             String
  job               Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  quantity          Decimal            @db.Decimal(10, 3)
  unitCost          Decimal?           @db.Decimal(10, 2)
  unitPrice         Decimal            @db.Decimal(10, 2)
  total             Decimal            @db.Decimal(10, 2)
  workItemId        String? // source price-book item, when picked from the price book
  recurringInterval RecurringInterval? // snapshot from the price book; null = sold one-time
  sortOrder         Int                @default(0)

  @@index([jobId])
}

// A single required task on a job, materialized from the checklists of the
// price-book services on its line items (lib/job-checklist.ts syncs them by
// service name). Every item must be done OR carry a skip reason before the
// job can leave ACTIVE (enforced in the job status route).
model JobChecklistItem {
  id         String    @id @default(cuid())
  jobId      String
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  label      String
  // Name of the price-book service this task came from — the sync key.
  sourceName String
  sortOrder  Int       @default(0)
  doneAt     DateTime?
  doneById   String?
  doneBy     User?     @relation(fields: [doneById], references: [id])
  // Why this task was NOT done (mutually exclusive with doneAt in practice)
  skipReason String?
  createdAt  DateTime  @default(now())

  @@unique([jobId, sourceName, label])
  @@index([jobId])
}

model JobAssignment {
  id     String @id @default(cuid())
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([jobId, userId])
  @@index([userId])
}

// ─── Time tracking ────────────────────────────────────────────────────────────

enum TimeEntrySource {
  CLOCK // live clock-in/out from the tech's device
  MANUAL // typed in or edited by a manager (forgotten clock-out, paper fix)
}

// One clock-in → clock-out span for a user on a job. endedAt null = currently
// on the clock; at most one open entry per user, enforced in the clock route
// (a new clock-in auto-closes any prior open entry). GPS fields are single
// point-in-time stamps captured at the moment of the tap — never continuous
// tracking, and only while clocking. Job deletion keeps the hours (SetNull)
// so payroll totals survive.
model TimeEntry {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id])
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId         String?
  job           Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  startedAt     DateTime
  endedAt       DateTime?
  source        TimeEntrySource @default(CLOCK)
  note          String?
  // Client-generated key so a retried/queued clock tap can't double-create
  clientKey     String?         @unique
  // Key of the clock-OUT tap that closed this entry — a replayed/queued
  // clock-out matches here instead of closing whatever span is open now
  endClientKey  String?         @unique
  // Location stamps (nullable — tech may deny location); accuracy in meters
  startLat      Float?
  startLng      Float?
  startAccuracy Float?
  endLat        Float?
  endLng        Float?
  endAccuracy   Float?
  // Manager who last hand-edited this entry (audit trail for payroll)
  editedById    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  locationPings LocationPing[]

  @@index([companyId, startedAt])
  @@index([companyId, endedAt])
  @@index([userId, endedAt])
  @@index([jobId])
}

// Team-map position report, posted by the app every few minutes WHILE (and
// only while) the user is clocked in with the app in the foreground — the
// server rejects pings with no open TimeEntry, so location is structurally
// impossible to collect off the clock. Short retention: the cron prunes pings
// older than 30 days (location history is a liability, not an asset).
model LocationPing {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id])
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntryId String?
  timeEntry   TimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)
  lat         Float
  lng         Float
  accuracy    Float? // meters
  recordedAt  DateTime   @default(now())

  @@index([companyId, recordedAt])
  @@index([userId, recordedAt])
}

model JobNote {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  // Client-generated key so a queued/retried note post can't double-create
  clientKey String?  @unique
  createdAt DateTime @default(now())

  @@index([jobId])
}

enum PhotoType {
  BEFORE
  AFTER
  GENERAL
}

model JobPhoto {
  id         String    @id @default(cuid())
  jobId      String
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  type       PhotoType @default(GENERAL)
  // Bytes live in R2 when object storage is configured (storageKey set, data
  // null); otherwise they fall back to the `data` column, which is how every
  // photo was stored before R2. Both are served through /api/job-photos/[id].
  // sizeBytes is recorded either way so the nightly storage rollup can still
  // measure a company's footprint once the bytes leave Postgres.
  data       Bytes?
  storageKey String?
  sizeBytes  Int?
  mimeType   String?
  createdAt  DateTime  @default(now())

  @@index([jobId])
}

// ─── Quotes ───────────────────────────────────────────────────────────────────

enum QuoteStatus {
  DRAFT
  AWAITING_RESPONSE
  APPROVED
  CHANGES_REQUESTED
  CONVERTED
  ARCHIVED
}

enum DepositType {
  NONE
  PERCENT
  FIXED
  FULL // all payment due upfront (deposit equals the full total)
}

model Quote {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id])
  contactId     String
  contact       Contact         @relation(fields: [contactId], references: [id])
  requestId     String?
  request       Request?        @relation(fields: [requestId], references: [id])
  jobId         String?         @unique // set when this quote is converted into a job
  job           Job?            @relation(fields: [jobId], references: [id])
  // The estimate tool this quote started from — an in-app run's "Create
  // quote", or a website estimate form. The tool's page lists them under
  // Leads (docs/plans/ai-estimators-2026-09-19.md, Batch 13).
  estimatorId   String?
  estimator     Estimator?      @relation(fields: [estimatorId], references: [id], onDelete: SetNull)
  // Saved service address this quote is for — carried onto the job at
  // convert time so multi-property clients keep the right property
  propertyId    String?
  property      ContactAddress? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  quoteNumber   Int
  title         String?
  // Discount applies to the subtotal before tax; carries to the invoice
  discountType  DepositType     @default(NONE)
  discountValue Decimal?        @db.Decimal(10, 2)
  discount      Decimal?        @db.Decimal(10, 2) // computed amount
  status        QuoteStatus     @default(DRAFT)
  subtotal      Decimal         @db.Decimal(10, 2)
  taxRate       Decimal?        @db.Decimal(5, 4)
  tax           Decimal?        @db.Decimal(10, 2)
  total         Decimal         @db.Decimal(10, 2)
  depositType   DepositType     @default(NONE)
  depositValue  Decimal?        @db.Decimal(10, 2) // percent (0-100) or fixed dollars
  clientMessage String?
  disclaimer    String?
  notes         String?
  validUntil    DateTime?
  sentAt        DateTime?
  // Client opened the public /quote page (beacon-stamped, own-company previews
  // excluded — see /api/public/viewed). First view pushes the team.
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  viewCount     Int             @default(0)
  approvedAt    DateTime?
  signatureName String?
  changeRequest String?
  publicToken   String          @unique @default(cuid())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  lineItems QuoteLineItem[]
  contracts Contract[]
  invoices  Invoice[] // deposit (and any other) invoices issued against this quote
  reminders QuoteReminder[]
  revisions QuoteRevision[]

  @@unique([companyId, quoteNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([contactId])
}

// A quote as the client last saw it, captured right before an after-send edit
// rewrites the live document. Editing a DRAFT never snapshots (nobody saw it);
// editing a sent/change-requested quote does, so "what did we originally
// offer?" always has an answer.
model QuoteRevision {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  revision  Int // 1-based, in the order the versions existed
  total     Decimal  @db.Decimal(10, 2)
  // Full document snapshot: title, message, totals, validity, line items
  snapshot  Json
  createdAt DateTime @default(now())

  @@unique([quoteId, revision])
  @@index([quoteId])
}

model QuoteLineItem {
  id                String             @id @default(cuid())
  quoteId           String
  quote             Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name              String             @default("")
  description       String
  quantity          Decimal            @db.Decimal(10, 3)
  unitCost          Decimal?           @db.Decimal(10, 2)
  unitPrice         Decimal            @db.Decimal(10, 2)
  total             Decimal            @db.Decimal(10, 2)
  isOptional        Boolean            @default(false)
  optedOut          Boolean            @default(false) // client unchecked this optional item in the hub
  // Snapshotted from WorkItem.requiresAgreement when picked from the price book
  requiresAgreement Boolean            @default(false)
  // Source price-book item (when picked from the price book) — lets conversion
  // read the live recurring config; null for free-typed lines
  workItemId        String?
  // Snapshotted from WorkItem.recurringInterval — drives subscription creation
  // on conversion and the "Billed monthly" label on client-facing pages
  recurringInterval RecurringInterval?
  sortOrder         Int                @default(0)

  @@index([quoteId])
}

// ─── Invoices ─────────────────────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  PAST_DUE
  // Shelved without destroying the paper trail (wrong invoice, client bailed).
  // Excluded from dunning and the default list; reopen restores the live state.
  ARCHIVED
}

// Distinguishes a deposit invoice (collected up front against an approved quote)
// from a normal/final invoice. A quote's final invoice nets any PAID deposits.
enum InvoiceKind {
  STANDARD
  DEPOSIT
}

model Invoice {
  id                  String        @id @default(cuid())
  companyId           String
  company             Company       @relation(fields: [companyId], references: [id])
  contactId           String?
  contact             Contact?      @relation(fields: [contactId], references: [id])
  jobId               String?       @unique
  job                 Job?          @relation(fields: [jobId], references: [id])
  // Set when this invoice was auto-generated by a recurring subscription cycle
  subscriptionId      String?
  subscription        Subscription? @relation(fields: [subscriptionId], references: [id])
  // Deposit invoices link back to the quote they collect against, so the quote's
  // final invoice can find and net any paid deposits.
  quoteId             String?
  quote               Quote?        @relation(fields: [quoteId], references: [id])
  kind                InvoiceKind   @default(STANDARD)
  invoiceNumber       Int
  subject             String?
  status              InvoiceStatus @default(DRAFT)
  subtotal            Decimal       @db.Decimal(10, 2)
  // Discount applies to the subtotal before tax
  discountType        DepositType   @default(NONE)
  discountValue       Decimal?      @db.Decimal(10, 2)
  discount            Decimal?      @db.Decimal(10, 2) // computed amount
  taxRate             Decimal?      @db.Decimal(5, 4)
  tax                 Decimal?      @db.Decimal(10, 2)
  surcharge           Decimal?      @db.Decimal(10, 2)
  // Deposit already paid on the originating quote, credited off this (final)
  // invoice. `total` is stored net of this; kept for the "Deposit applied" row.
  depositApplied      Decimal?      @db.Decimal(10, 2)
  total               Decimal       @db.Decimal(10, 2)
  notes               String?
  // Client-facing message at the top of the pay page / PDF (parity with
  // Quote.clientMessage; `notes` stays internal-facing on the editor).
  clientMessage       String?
  issuedAt            DateTime?
  dueDate             DateTime?
  paidAt              DateTime?
  // DEPRECATED — replaced by the per-user CelebrationSeen table; nothing reads
  // this anymore. Kept only so db push stays additive; drop in a later cleanup.
  paidCelebratedAt    DateTime?
  // Client opened the public /pay page (beacon-stamped — see /api/public/viewed)
  firstViewedAt       DateTime?
  lastViewedAt        DateTime?
  viewCount           Int           @default(0)
  publicToken         String        @unique @default(cuid())
  // ── Autopay retry state (recurring engine — lib/auto-charge.ts) ────────────
  // Failed card-on-file attempts on this engine-generated invoice; the cron
  // retries at autoChargeNextAt (null = nothing scheduled). Gave-up = hard
  // decline or retries exhausted; cleared when the client saves a new card.
  autoChargeAttempts  Int           @default(0)
  autoChargeNextAt    DateTime?
  autoChargeLastError String?
  autoChargeGaveUpAt  DateTime?
  // Short-lived charge mutex (lib/payments.ts acquireChargeLock): only one
  // charge attempt — staff, /pay, or autopay — may be in flight per invoice.
  // A stale stamp (crashed charge) expires by lease, never needs cleanup.
  chargeLockedAt      DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  lineItems        InvoiceLineItem[]
  payments         Payment[]
  reminders        PaymentReminder[]
  // Visit jobs this invoice consolidated (Job.consolidatedInvoiceId)
  consolidatedJobs Job[]             @relation("ConsolidatedVisits")

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([companyId, status])
  // Past-due checks (nav-counts on every navigation, invoices list) filter
  // companyId + status + dueDate
  @@index([companyId, status, dueDate])
  @@index([quoteId])
  @@index([status, autoChargeNextAt])
}

// ─── Celebrations ─────────────────────────────────────────────────────────────

enum CelebrationKind {
  INVOICE_PAID
  QUOTE_APPROVED
}

// Per-user one-shot confetti flags: each staff member sees the moment once
// (invoice paid online / quote approved by the client). Rows for an invoice
// are deleted when it reopens (refund / bounced ACH / manual un-pay) so a
// genuine re-payment celebrates again for everyone.
model CelebrationSeen {
  id       String          @id @default(cuid())
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind     CelebrationKind
  entityId String // Invoice.id or Quote.id, per kind
  seenAt   DateTime        @default(now())

  @@unique([userId, kind, entityId])
  @@index([kind, entityId])
}

model InvoiceLineItem {
  id                String             @id @default(cuid())
  invoiceId         String
  invoice           Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name              String             @default("")
  description       String
  quantity          Decimal            @db.Decimal(10, 3)
  // Cost basis for margin reporting — backfilled from the price book by name
  // (same as quotes/jobs); never shown to the client. Direct invoices used to
  // drop cost data entirely, silently excluding them from profit numbers.
  unitCost          Decimal?           @db.Decimal(10, 2)
  unitPrice         Decimal            @db.Decimal(10, 2)
  total             Decimal            @db.Decimal(10, 2)
  serviceDate       DateTime?
  workItemId        String? // source price-book item, when picked from the price book
  recurringInterval RecurringInterval? // display-only snapshot from the price book
  sortOrder         Int                @default(0)

  @@index([invoiceId])
}

// ─── Payments ─────────────────────────────────────────────────────────────────

enum PaymentMethod {
  CARD
  ACH
  CASH
  CHECK
  CASH_APP
  PAYPAL
  VENMO
  ZELLE
  OTHER
}

model Payment {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  contactId       String?
  contact         Contact?      @relation(fields: [contactId], references: [id])
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod
  referenceNumber String?
  details         String?
  processorRef    String? // transaction id from the payment processor (card/ACH)
  surchargeAmount Decimal?      @db.Decimal(10, 2)
  // Platform-economics columns (superadmin profitability tracking). Only set
  // on processor-run payments; manual/check/cash rows stay null.
  feeCents        Int? // processing fee billed to the merchant (our gross revenue), from the fee profile at charge time
  cardBrand       String? // VISA / MASTERCARD / AMERICAN_EXPRESS ... from the Finix payment instrument
  cardType        String? // CREDIT / DEBIT — drives the interchange cost estimate
  estCostCents    Int? // estimated buy-rate cost (interchange + Finix margin); trued up monthly via FinixCostSnapshot
  paidAt          DateTime      @default(now())
  createdAt       DateTime      @default(now())

  refunds Refund[]

  @@index([companyId])
  // Dashboard / business / insights / payments all range-scan paidAt per company
  @@index([companyId, paidAt])
  @@index([invoiceId])
  @@index([contactId])
}

// One processor reversal (full or partial) against a Payment. The Payment's
// `amount` is decremented in place when a refund lands — every balance/status
// computation keys off it — so this row is the durable record: what came back,
// when, and under which Finix reversal id. Original charge = amount + Σrefunds.
// A reversal that later FAILS at the processor deletes its row and restores
// the amount (see the Finix webhook), so surviving rows are money that moved.
model Refund {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount          Decimal  @db.Decimal(10, 2)
  // Portion of `amount` that was card surcharge — restored alongside the
  // principal when the reversal fails. Null on rows written before 2026-09.
  surchargeAmount Decimal? @db.Decimal(10, 2)
  reversalRef     String? // Finix reversal transfer id
  createdAt       DateTime @default(now())

  @@index([companyId])
  @@index([paymentId])
  @@index([reversalRef])
}

model PaymentReminder {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type      String
  sentAt    DateTime

  @@unique([invoiceId, type])
  @@index([invoiceId])
}

// One row per follow-up stage sent on an awaiting quote — same atomic-claim
// pattern as PaymentReminder (the @@unique is the lock; see lib/reminders.ts).
model QuoteReminder {
  id      String   @id @default(cuid())
  quoteId String
  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  type    String
  sentAt  DateTime

  @@unique([quoteId, type])
  @@index([quoteId])
}

// ─── Activity log ─────────────────────────────────────────────────────────────

// Light audit trail for money-touching mutations (who changed a status,
// deleted a payment, ran a refund/stored charge). Append-only; written
// fire-and-forget via lib/activity.ts so it can never fail the mutation.
model ActivityLog {
  id         String   @id @default(cuid())
  companyId  String
  // Plain string user id (no FK) so history survives team-member deletion
  userId     String?
  userName   String?
  entityType String // "invoice" | "quote" | "payment" | "job" | ...
  entityId   String
  action     String // "status_changed" | "payment_deleted" | "refund" | ...
  detail     String?
  createdAt  DateTime @default(now())

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
}

// ─── Nightly financial reconciliation (lib/reconcile.ts) ─────────────────────

// One row per nightly reconciliation sweep. The sweep re-derives every money
// invariant (invoice math, status-vs-balance, duplicate charges, subscription
// shape, Finix transfer cross-check) and emails the platform operator when
// anything drifted. The latest row also acts as the once-a-day gate on the
// hourly cron. Findings are stored as JSON for the paper trail.
model ReconcileRun {
  id              String    @id @default(cuid())
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  companies       Int       @default(0)
  invoicesChecked Int       @default(0)
  errorCount      Int       @default(0)
  warningCount    Int       @default(0)
  // [{ companyId, companyName, severity: "error"|"warning", check, entity, entityId, detail }]
  findings        Json?
  emailedTo       String?

  @@index([startedAt])
}

// ─── Platform usage metering (superadmin cost tracking) ──────────────────────

// One row per company per UTC day, upserted with atomic increments by
// lib/usage.ts. companyId is a PLAIN string — deliberately no FK — so cost
// history survives company deletion; the sentinel "platform" collects sends
// that belong to no tenant (password resets, portal logins).
model CompanyUsageDaily {
  id             String   @id @default(cuid())
  companyId      String // Company.id, or "platform" for unattributed
  day            String // UTC date "2026-07-20" — lexicographic order == chronological
  aiCalls        Int      @default(0)
  aiTokensIn     Int      @default(0)
  aiTokensOut    Int      @default(0)
  aiTokensCached Int      @default(0)
  emailsSent     Int      @default(0)
  smsSent        Int      @default(0)
  smsSegments    Int      @default(0)
  // Mapbox spend guards (lib/mapbox-budget.ts): API lookups + matrix cells
  // actually sent to Mapbox (cache hits cost nothing and aren't counted).
  // The month-to-date platform-wide sum is the free-tier kill switch.
  geocodeCalls   Int      @default(0)
  matrixElements Int      @default(0)
  storageBytes   BigInt? // nightly snapshot (photos + logos + avatars), not a counter
  updatedAt      DateTime @updatedAt

  @@unique([companyId, day])
  @@index([day])
}

// One row per Atlas assistant turn — the spend ledger behind the paid plan's
// token meter (lib/assistant-billing.ts) and the superadmin usage readout.
// Written for every access level (trial/plan/full) so per-company burn is
// visible before anyone pays. Plain companyId/userId (no FKs), same as
// CompanyUsageDaily: cost history outlives the tenant.
model AssistantTurn {
  id           String   @id @default(cuid())
  companyId    String
  userId       String
  createdAt    DateTime @default(now())
  access       String // "trial" | "plan" | "full"
  kind         String   @default("chat") // "chat" | "estimator" — what the tokens bought
  model        String
  rounds       Int      @default(1) // model calls in this turn
  toolCalls    Int      @default(0)
  proposals    Int      @default(0) // confirmation cards staged
  tokensIn     Int      @default(0)
  tokensOut    Int      @default(0)
  tokensCached Int      @default(0)
  costCents    Float    @default(0) // what the turn cost US
  atlasTokens  Int      @default(0) // what the plan meter was debited
  ok           Boolean  @default(true)

  @@index([companyId, createdAt])
}

// Monthly per-merchant ACTUALS imported from Finix's Net Profit report
// (dashboard-only CSV — Finix exposes no report API). Where a snapshot
// exists, /superadmin shows these numbers instead of estimates.
model FinixCostSnapshot {
  id                   String   @id @default(cuid())
  finixMerchantId      String
  month                String // "2026-07"
  cardSaleCents        BigInt   @default(0)
  echeckSaleCents      BigInt   @default(0)
  cardFeesCents        BigInt   @default(0) // fees billed to the merchant = our gross processing revenue
  interchangeFeesCents BigInt   @default(0) // actual interchange cost incurred
  residualCents        BigInt   @default(0) // Finix-reported net margin (the authoritative number)
  raw                  Json? // full CSV row, for columns not modeled here
  importedAt           DateTime @default(now())

  @@unique([finixMerchantId, month])
}

// ─── Price Book ───────────────────────────────────────────────────────────────

enum WorkItemType {
  SERVICE
  PRODUCT
}

// Subscription cadence for recurring services. SEMIANNUAL = every 6 months
// ("biannually"). Kept distinct from the job-scheduling Frequency enum, which
// is about how often a visit recurs (weekly/biweekly), not how often you bill.
enum RecurringInterval {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

// What the recurring engine does with each billing cycle's invoice.
enum RecurringInvoiceMode {
  SEND // auto-send (auto-charge a card on file once the processor is live, else email a pay link)
  DRAFT // mint a draft invoice for the company to review and send manually
}

// When an attached agreement is auto-sent to the client.
enum AgreementTiming {
  WITH_QUOTE // send as soon as the quote goes out
  ON_APPROVAL // send only once the quote is approved
}

// How a service's price is presented to homeowners (booking form + client
// pages). Trades rarely flat-rate everything: variable-scope work is quoted
// "starting at", T&M work is hourly, and big-ticket jobs hide the number
// behind a free estimate. unitPrice stays the numeric anchor either way.
enum PriceDisplay {
  FIXED // "$150.00" — flat rate per job
  STARTING_AT // "From $150" — final price depends on scope
  HOURLY // "$95/hr" — time & materials
  QUOTE // no number — "Free estimate / we'll quote it"
}

model WorkItem {
  id                   String               @id @default(cuid())
  companyId            String
  company              Company              @relation(fields: [companyId], references: [id])
  name                 String
  description          String?
  type                 WorkItemType         @default(SERVICE)
  unitCost             Decimal?             @db.Decimal(10, 2)
  unitPrice            Decimal              @default(0) @db.Decimal(10, 2)
  // How the price reads on client-facing surfaces (booking form)
  priceDisplay         PriceDisplay         @default(FIXED)
  // Preset deposit for this service. Snapshots onto quotes built from the price
  // book (summed across services) and drives the deposit invoice on approval.
  // NONE = fall back to the company default. FULL = whole line due upfront.
  depositType          DepositType          @default(NONE)
  depositValue         Decimal?             @db.Decimal(10, 2) // percent (0-100) or fixed dollars
  // How long this service takes on site — feeds the online-booking slot
  // engine. null = not offerable for self-scheduling.
  durationMinutes      Int?
  // Recurring/subscription settings. null interval = one-time service.
  recurringInterval    RecurringInterval?
  recurringCreatesJob  Boolean              @default(false) // also spin up a job each cycle (visit-based work)
  recurringInvoiceMode RecurringInvoiceMode @default(SEND)
  // Quotes containing this service can't convert to a job until a linked
  // agreement is signed (flag snapshots onto QuoteLineItem at pick time).
  // Set automatically whenever an agreement template is attached.
  requiresAgreement    Boolean              @default(false)
  // Task list for this service (Json string[]). Jobs whose line items include
  // this service materialize these as JobChecklistItems, which must each be
  // checked off (or given a skip reason) before the job can be closed out.
  checklist            Json?
  // Optional agreement that auto-sends with quotes for this service
  agreementTemplateId  String?
  agreementTemplate    ContractTemplate?    @relation(fields: [agreementTemplateId], references: [id])
  agreementTiming      AgreementTiming      @default(ON_APPROVAL)
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  subscriptions       Subscription[]
  bookingTypeServices BookingTypeService[]

  @@index([companyId])
  @@index([companyId, name])
}

// ─── Subscriptions (recurring services sold to a client) ─────────────────────

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

// A live recurring agreement: created when a recurring price-book service is
// sold (quote→job, direct invoice, or web-form service request). The recurring
// engine (lib/subscriptions.ts) sweeps ACTIVE rows whose nextRunDate is due and
// generates the next invoice (and optionally a job). Snapshots name/price so it
// survives price-book edits/deletes.
model Subscription {
  id                 String               @id @default(cuid())
  companyId          String
  company            Company              @relation(fields: [companyId], references: [id])
  contactId          String
  contact            Contact              @relation(fields: [contactId], references: [id])
  workItemId         String?
  workItem           WorkItem?            @relation(fields: [workItemId], references: [id])
  name               String
  description        String?
  unitPrice          Decimal              @db.Decimal(10, 2)
  quantity           Decimal              @default(1) @db.Decimal(10, 3)
  // BILLING cadence — null = a standalone recurring-job series ("mow every
  // 2 weeks") that schedules visits via the series below but never bills
  interval           RecurringInterval?
  // Bill after each completed visit instead of on a calendar schedule:
  // completing one of this series' visit jobs mints an invoice for
  // unitPrice × quantity (sent/charged or drafted per invoiceMode). Mutually
  // exclusive with `interval` — a series bills on a schedule, per visit, or
  // not at all.
  billPerVisit       Boolean              @default(false)
  // Per-visit pricing, but ONE invoice a month instead of one per visit:
  // completed visits accumulate and runMonthlyConsolidations bills them all
  // on nextRunDate (the 1st, advancing monthly) as a single invoice with a
  // dated line per visit. Only meaningful with billPerVisit.
  consolidateMonthly Boolean              @default(false)
  createsJob         Boolean              @default(false)
  invoiceMode        RecurringInvoiceMode @default(SEND)
  status             SubscriptionStatus   @default(ACTIVE)
  // date-only, noon-anchored; the engine bills when due (null = never bills)
  nextRunDate        DateTime?
  // Stripe-style billing anchor: the day the plan's FIRST payment succeeded.
  // Set once by recordPayment, which re-points nextRunDate so every later
  // cycle lands on this day-of-month (clamped for short months). Null until
  // the first payment lands (or forever, for pre-anchor legacy plans).
  anchoredAt         DateTime?
  lastGeneratedAt    DateTime? // guards against double-billing on repeated/overlapping runs
  // Saved service address generated visits land at (see Job.propertyId)
  propertyId         String?
  property           ContactAddress?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  // Autopay card pinned to this series — null = the contact's default card.
  // Resolution happens at charge time (lib/auto-charge.ts), so a swapped
  // default card takes effect on the next charge without touching the series.
  savedCardId        String?
  savedCard          SavedCard?           @relation(fields: [savedCardId], references: [id], onDelete: SetNull)

  // ── Visit series (visit cadence decoupled from billing) ─────────────────────
  // "Weekly mows, billed monthly": visitFrequency generates visit jobs on its
  // own cadence while `interval` keeps billing. The engine materializes visits
  // on a rolling horizon so dispatchers see them on the calendar; each visit is
  // an ordinary Job (drag to reschedule / delete to skip — the series doesn't
  // care). null visitFrequency = no separate series (legacy createsJob applies).
  visitFrequency       Frequency?
  nextVisitDate        DateTime? // date-only, noon-anchored; next unmaterialized visit
  visitStartMinutes    Int? // minutes from midnight, company TZ; null = "Anytime"
  visitDurationMinutes Int? // visit window length in minutes; null = 60
  visitAssigneeIds     String[]   @default([]) // default team copied onto generated visits
  lastVisitGeneratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]
  jobs     Job[]

  @@index([companyId])
  @@index([companyId, status, nextRunDate])
  @@index([status, nextVisitDate])
  @@index([contactId])
}

// Visit cadence for a subscription's visit series (billing cadence lives in
// RecurringInterval — the two are deliberately separate enums).
enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

// ─── Booking Requests (legacy public booking form) ───────────────────────────

enum BookingStatus {
  NEW
  CONTACTED
  CONVERTED
  DECLINED
}

model BookingRequest {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  contactId     String?
  contact       Contact?      @relation(fields: [contactId], references: [id])
  firstName     String
  lastName      String
  email         String?
  phone         String?
  address       String?
  service       String
  preferredDate DateTime?
  message       String?
  status        BookingStatus @default(NEW)
  createdAt     DateTime      @default(now())

  @@index([companyId])
  @@index([companyId, status])
}

// ─── Review Requests ──────────────────────────────────────────────────────────

model ReviewRequest {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  contactId String?
  jobId     String?
  email     String?
  phone     String?
  sentAt    DateTime
  method    String
  status    String   @default("sent")
  createdAt DateTime @default(now())

  @@index([companyId])
