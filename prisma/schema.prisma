// ─── QuickBooks Online integration ───────────────────────────────────────────

// One QBO connection per company (Settings → QuickBooks). Tokens are
// AES-256-GCM encrypted at rest by lib/quickbooks.ts (key derived from
// AUTH_SECRET); realmId is Intuit's id for the connected company file.
// The sync is one-way push: Contact → Customer, Invoice → Invoice,
// Payment → Payment. Refresh tokens roll for ~100 days — a company that
// goes idle longer than that must reconnect (lastSyncError says so).
model QuickBooksConnection {
  id                    String    @id @default(cuid())
  companyId             String    @unique
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  realmId               String
  accessTokenEnc        String
  refreshTokenEnc       String
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  // Push invoices/payments as they happen + nightly cron sweep. Off = only
  // the manual "Sync now" button moves data.
  autoSync              Boolean   @default(true)
  qboCompanyName        String? // CompanyInfo display name, shown in settings
  // Lazily resolved on first sync: the generic Service item our invoice lines
  // bill against ("Streamflaire Services") and the income account behind it.
  defaultItemId         String?
  incomeAccountId       String?
  // Card surcharges bill against their own Service item so processing fees
  // show up as their own income line in QBO reports, not buried in services
  surchargeItemId       String?
  // Expense (Purchase) push: the expense account lines post to and the
  // bank/credit account they're paid from — both lazily resolved on first use
  expenseAccountId      String?
  paymentAccountId      String?
  lastSyncAt            DateTime?
  lastSyncError         String? // most recent connection-level failure; null = healthy
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  syncRecords QuickBooksSyncRecord[]
}

enum QuickBooksEntityType {
  CUSTOMER
  INVOICE
  PAYMENT
  ESTIMATE // our Quote
  PURCHASE // our Expense
}

enum QuickBooksSyncStatus {
  SYNCED
  ERROR
}

// ─── Calendar sync (docs/plans/google-calendar-sync-2026-09-11.md) ──────────

// Private .ics subscribe link — one per user. The token IS the credential
// (32 random bytes, base64url); the public feed route 404s on anything else.
// Regenerating rotates the token; deleting the row turns the feed off.
model CalendarFeed {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         String    @unique
  lastFetchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// One-way push of a user's schedule into their Google account's primary
// calendar (lib/google-calendar.ts). Tokens are AES-256-GCM encrypted at rest
// like QuickBooksConnection; Google refresh tokens don't expire on a clock,
// but a revoked/expired grant surfaces as lastSyncError + reconnect.
model GoogleCalendarConnection {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId            String
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  googleEmail          String
  calendarId           String    @default("primary")
  accessTokenEnc       String
  refreshTokenEnc      String
  accessTokenExpiresAt DateTime
  scope                String
  // Pause without disconnecting: events already pushed stay put, nothing
  // new goes out until re-enabled.
  syncEnabled          Boolean   @default(true)
  lastSyncAt           DateTime?
  lastSyncError        String? // most recent failure; null = healthy
  // Two-way: mirror the Google account's busy events into Workbench as
  // GOOGLE time blocks (lib/google-calendar-pull.ts). shareTitles = the
  // block carries the Google event name instead of "Busy" (teammates see it).
  pullEnabled          Boolean   @default(true)
  shareTitles          Boolean   @default(false)
  // Google incremental sync cursor; null = next pull is a full window read
  pullSyncToken        String?
  lastPullAt           DateTime?
  lastPullError        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  events GoogleCalendarEvent[]

  @@index([companyId])
}

enum CalendarEventKind {
  JOB
  APPOINTMENT
  BLOCK
}

// Local schedule row ↔ Google event id. fingerprint = sha256 of the rendered
// event, so the reconcile sweep only PATCHes what actually changed.
model GoogleCalendarEvent {
  id            String                   @id @default(cuid())
  connectionId  String
  connection    GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  kind          CalendarEventKind
  localId       String
  googleEventId String
  fingerprint   String
  updatedAt     DateTime                 @updatedAt

  @@unique([connectionId, kind, localId])
}

// Local row ↔ QBO entity mapping. qboSyncToken is QBO's optimistic-lock
// version, required on every update; localUpdatedAt is the local row's
// updatedAt at push time — a newer local updatedAt means re-push.
model QuickBooksSyncRecord {
  id             String               @id @default(cuid())
  connectionId   String
  connection     QuickBooksConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  companyId      String
  entityType     QuickBooksEntityType
  localId        String
  qboId          String?
  qboSyncToken   String?
  status         QuickBooksSyncStatus @default(SYNCED)
  error          String?
  localUpdatedAt DateTime?
  lastSyncedAt   DateTime             @default(now())

  @@unique([companyId, entityType, localId])
  @@index([connectionId])
  @@index([companyId, status])
}

// ─── Invite-gated onboarding ─────────────────────────────────────────────────

// A single-use code that authorizes one company signup. Minted by a
// superadmin — directly from /superadmin/invites or by approving an
// AccessApplication — and required by /api/app/register.
model InviteCode {
  id              String    @id @default(cuid())
  code            String    @unique // human-typable, e.g. WB-7K2M-9QX4
  note            String? // superadmin's memo: who this is for
  email           String? // where it was sent — informational, not enforced
  // LEGACY (2026-09-04): there used to be "standard" vs "sandbox bypass"
  // codes; now EVERY code skips the human review AND waives Finix
  // underwriting (see lib/invites.ts). Column kept because boot-time db push
  // can't drop it; nothing reads it any more.
  bypassApproval  Boolean   @default(false)
  expiresAt       DateTime? // null = never expires
  usedAt          DateTime?
  usedByCompanyId String?   @unique
  usedByCompany   Company?  @relation(fields: [usedByCompanyId], references: [id], onDelete: SetNull)
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  applicationId String?            @unique
  application   AccessApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Public /apply form submissions, reviewed at /superadmin/applications.
// Approving one mints an InviteCode and emails it to the applicant.
model AccessApplication {
  id              String            @id @default(cuid())
  // The applicant ticked the (unchecked-by-default) box to receive WorkBench's
  // own sales & support texts at `phone` — the opt-in behind the platform's
  // toll-free verification (lib/business-line.ts platformTollFreeInput).
  smsConsentAt    DateTime?
  name            String
  email           String
  phone           String?
  companyName     String
  industry        String?
  teamSize        String?
  website         String?
  message         String?
  // Payment-intent screening (2026-07): every company must pass Finix
  // underwriting, so the application asks up front whether they're a real
  // business that will actually run card volume.
  city            String?
  state           String?
  paymentsToday   String? // how they collect payment now (cash-only is a flag)
  monthlyVolume   String? // monthly invoicing range — our revenue forecast
  yearsInBusiness String?
  entityType      String? // LLC/corp vs sole prop vs not registered
  status          ApplicationStatus @default(PENDING)
  decidedAt       DateTime?
  createdAt       DateTime          @default(now())

  // The company opened by the self-serve onboarding flow (null on legacy
  // invite-code applications). While the application is PENDING the company
  // carries accessPendingAt; approving clears it, rejecting suspends.
  companyId String?  @unique
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  inviteCode InviteCode?

  @@index([status])
}

// Every provider (Telnyx) text we send, by recipient — the inbound webhook
// routes a reply to the company that last texted that number, and scopes a
// STOP to the companies that have actually texted it. Pool numbers are
// shared across tenants, so the phone number alone can't say who a client
// is replying to.
model SmsSend {
  id         String   @id @default(cuid())
  companyId  String
  contactId  String?
  toDigits   String // last 10 digits of the recipient
  fromNumber String? // the pool number Telnyx sent from (E.164)
  createdAt  DateTime @default(now())

  @@index([toDigits, createdAt])
  @@index([companyId, createdAt])
}

// ─── Business line: 10DLC registration ──────────────────────────────────────

// Where a company's texting stands with the carriers. Voice never waits on
// this — only lib/sms.ts sendSms gates on ACTIVE.
//   BRAND_PENDING    brand submitted, TCR still verifying the EIN (or the
//                    sole-prop owner still has to enter the OTP PIN)
//   CAMPAIGN_PENDING brand verified, campaign submitted, carriers reviewing
//   ACTIVE           campaign accepted and the number is bound to it
//   REJECTED         a step failed — rejectionReason says why; Resubmit starts over
enum LineRegistrationStatus {
  QUEUED // Telnyx refused the filing for lack of funds on the platform account; form stored, refiled by the hourly sweep
  AWAITING_REVIEW // form stored, nothing filed: a re-file after a rejection (or every first filing with LINE_REGISTRATION_REVIEW=1) waits for a superadmin — TCR charges per submission
  BRAND_PENDING
  CAMPAIGN_PENDING
  ACTIVE
  REJECTED
}

// One per company: the business registered behind Company.lineNumber, plus
// the Telnyx/TCR ids and statuses lib/business-line.ts advances through.
// The business fields are stored so a rejected submission can be edited and
// resubmitted without retyping, and so support can see what was filed.
model MessagingRegistration {
  id                 String                 @id @default(cuid())
  companyId          String                 @unique
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status             LineRegistrationStatus @default(BRAND_PENDING)
  // "10DLC" (local number: brand → campaign → number binding) or "TOLL_FREE"
  // (toll-free number: one verification request, statuses in verificationStatus)
  kind               String                 @default("10DLC")
  entityType         String // "PRIVATE_PROFIT" (has EIN) | "SOLE_PROPRIETOR"
  legalName          String
  displayName        String
  ein                String? // 9 digits, PRIVATE_PROFIT only
  street             String
  city               String
  state              String
  postalCode         String
  website            String?
  vertical           String // TCR vertical, e.g. CONSTRUCTION / PROFESSIONAL
  contactFirstName   String
  contactLastName    String
  contactEmail       String
  contactPhone       String // E.164; the sole-prop OTP goes here
  brandId            String? // Telnyx brand id
  tcrBrandId         String?
  brandStatus        String? // Telnyx identityStatus: VERIFIED | UNVERIFIED | SELF_DECLARED | VETTED_VERIFIED
  campaignId         String? // Telnyx campaign id
  tcrCampaignId      String?
  campaignStatus     String? // Telnyx campaignStatus (TCR_PENDING … MNO_PROVISIONED)
  assignmentStatus   String? // number ↔ campaign: PENDING_ASSIGNMENT | ASSIGNED | FAILED_ASSIGNMENT
  verificationId     String? // TOLL_FREE: Telnyx verification request id
  verificationStatus String? // TOLL_FREE: Verified | Rejected | In Progress | Waiting For Vendor | Waiting For Customer | Waiting For Telnyx
  messageVolume      String? // TOLL_FREE: expected texts per month ("1,000")
  useCase            String? // TOLL_FREE: Telnyx use-case category ("Appointments")
  rejectionReason    String?
  submittedAt        DateTime               @default(now())
  approvedAt         DateTime?
  lastCheckedAt      DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([status])
}

// ─── Business line: calls ───────────────────────────────────────────────────

enum CallDirection {
  INBOUND
  OUTBOUND
}

// Where a call is, and how it ended. Inbound: RINGING (customer answered by
// us, owner's cell being tried) → IN_PROGRESS (owner pressed 1, legs bridged)
// → COMPLETED; or → VOICEMAIL / MISSED (caller left before the greeting or
// left nothing). Outbound: RINGING (owner's cell first, then the customer)
// → IN_PROGRESS → COMPLETED; NO_ANSWER when the customer never picked up;
// FAILED for anything else (owner never pressed 1, carrier error).
enum CallStatus {
  RINGING
  IN_PROGRESS
  COMPLETED
  MISSED
  VOICEMAIL
  NO_ANSWER
  FAILED
}

// One row per call on a company's business line (lib/voice.ts). The customer
// leg's Telnyx call_control_id is the primary key into the webhook stream;
// agentCallId is the owner's-cell leg. Voicemails are Telnyx recordings —
// we keep the id and fetch a fresh download URL when someone presses play.
model Call {
  id                   String        @id @default(cuid())
  companyId            String
  company              Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId            String?
  contact              Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // Outbound: who placed it. Inbound: null (the company cell answered, not a user).
  userId               String?
  user                 User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Who picked up in the app (softphone); null when the cell answered or nobody did.
  answeredByUserId     String?
  answeredBy           User?         @relation("AnsweredCalls", fields: [answeredByUserId], references: [id], onDelete: SetNull)
  // How the team side of the call was reached: "cell" (tier 1 whisper +
  // press 1) or "app" (browser softphone). Null until a leg is dialed.
  via                  String?
  // Inbound fan-out claim: set once when the softphone legs were dialed, so
  // a retried webhook can't ring everyone twice (lib/voice.ts).
  appRingAt            DateTime?
  direction            CallDirection
  status               CallStatus    @default(RINGING)
  customerNumber       String // E.164 of the far party
  customerDigits       String? // last 10, for contact matching (lib/phone.ts)
  agentNumber          String? // E.164 cell that rang / placed it
  telnyxCallId         String?       @unique // customer leg call_control_id
  agentCallId          String? // owner's-cell leg call_control_id
  customerLegId        String? // Telnyx call_leg_id of the customer leg (recordings filter)
  hangupCause          String?
  answeredAt           DateTime? // legs bridged
  endedAt              DateTime?
  durationSec          Int? // talk time (answeredAt → endedAt)
  voicemailRecordingId String?
  voicemailSec         Int?
  seenAt               DateTime? // a team member opened the Calls page after it ended
  // Notes typed on the call screen (app/platform/calls/[id]) — during or after the call.
  notes                String?
  notesAt              DateTime?
  // Atlas took the notes (lib/call-notes.ts): Telnyx transcribes the customer
  // leg into `transcript` ("You: … / Them: …" lines, final segments only) and
  // Atlas writes `atlasNotes` from it when the call ends or on "Stop".
  // atlasNotesState: null | "listening" | "summarizing" | "done" | "failed".
  transcript           String?
  atlasNotes           String?
  atlasNotesState      String?
  atlasNotesAt         DateTime?
  atlasNotesError      String?
  atlasNotesUserId     String? // who asked (and whose company meter pays)
  atlasNotesTokens     Int?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  legs                 CallLeg[]

  @@index([companyId, createdAt])
  @@index([contactId, createdAt])
  @@index([agentCallId])
  @@index([status, createdAt])
}

// One softphone leg of an inbound call (lib/softphone.ts): the SIP dial to
// one signed-in team member's browser. The cell leg stays on Call.agentCallId;
// when an app leg is answered its id is copied there too, so the rest of the
// state machine never has to know how many browsers rang.
model CallLeg {
  id           String    @id @default(cuid())
  callId       String
  call         Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  telnyxCallId String    @unique // call_control_id of this SIP leg
  // "browser" (a registered tab, rung at once) or "ios" (the iPhone app,
  // dialed once its VoIP push woke it) — its own credential either way.
  device       String?
  endedAt      DateTime?
  hangupCause  String?
  createdAt    DateTime  @default(now())

  @@index([callId])
}

// ─── Packaging board (superadmin planning tool) ──────────────────────────────

// A column on /superadmin/packaging: a subscription tier, a paid add-on, or
// the undeletable "Unassigned" backlog every feature starts in. This board is
// a PLANNING surface only — nothing here gates a real entitlement (that stays
// Company.addonActiveAt / lib/addon.ts). It exists so the packaging decision
// can be made by dragging cards, and so the /pricing page can be built from
// whatever the board says when it's settled.
enum PackagingLaneKind {
  TIER
  ADDON
  BACKLOG
}

model PackagingLane {
  id        String            @id @default(cuid())
  name      String
  kind      PackagingLaneKind @default(TIER)
  // Free text on purpose — a plan's price is "$0", "$29/mo", "2.9% + 30¢",
  // or "TBD" while it's being decided. Formatting is the board's job.
  price     String?
  priceNote String? // "per company, billed monthly", "per seat", …
  blurb     String? // the one-line pitch that becomes the tier's subtitle
  accent    String? // header hex; null = the stock blue/orange rotation
  sort      Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  cards PackagingCard[]

  @@index([sort])
}

model PackagingCard {
  id     String        @id @default(cuid())
  laneId String
  lane   PackagingLane @relation(fields: [laneId], references: [id], onDelete: Cascade)

  title      String
  body       String?
  // Where the feature came from in the marketing catalog ("Win the work",
  // "Get paid", …) — drives the card's tint and groups the backlog.
  group      String?
  icon       String? // lucide-react export name, for the pricing page later
  // Stable key for catalog-sourced cards (section id + slug of the title) so
  // re-syncing lib/wb-features.ts never duplicates a card the owner has
  // already placed. Null for cards typed in by hand.
  catalogKey String?  @unique
  sort       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([laneId, sort])
}
